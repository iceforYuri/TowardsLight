---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FloatingMainCard from '../../components/FloatingMainCard.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import PostNavigation from '../../components/PostNavigation.astro';
import Icon from '../../components/Icon.astro';
import { getAllPosts, formatDate, readingTime } from '../../utils/posts';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      prev: posts[i + 1], // 时间更早的一篇
      next: posts[i - 1], // 时间更晚的一篇
    },
  }));
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, pubDate, updatedDate, category, tags, cover, coverAlt, coverPosition } =
  post.data;
const minutes = readingTime(post.body ?? '');
---

<BaseLayout title={title} description={description}>
  <ReadingProgress />

  {/* 文章顶部视觉区:有封面用封面,无封面用纯色 */}
  <section class:list={['article-stage', { 'has-cover': cover }]}>
    {
      cover && (
        <div class="stage-backdrop" aria-hidden="true">
          <img
            src={cover}
            alt={coverAlt ?? ''}
            class="stage-img img-reveal"
            style={`object-position: ${coverPosition};`}
            loading="eager"
            onload="this.classList.add('is-loaded')"
            onerror="this.closest('.stage-backdrop')?.classList.add('is-broken'); this.remove()"
          />
          <div class="stage-scrim" />
        </div>
      )
    }
  </section>

  <div class="shell-container article-wrap">
    <FloatingMainCard overlap="stage" class="article-card">
      {/* 文章头部 */}
      <header class="article-header">
        <div class="article-breadcrumb font-mono">
          <a href={`/categories/${encodeURIComponent(category)}`} class="crumb-category">
            <Icon name="folder" size={13} />
            {category}
          </a>
        </div>
        <h1 class="article-title font-display">{title}</h1>
        <p class="article-desc">{description}</p>
        <div class="article-meta font-mono">
          <span class="meta-item">
            <Icon name="calendar" size={13} />
            <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
          </span>
          {
            updatedDate && (
              <span class="meta-item">
                <Icon name="refresh-cw" size={13} />
                更新于 {formatDate(updatedDate)}
              </span>
            )
          }
          <span class="meta-item">
            <Icon name="clock" size={13} />
            约 {minutes} 分钟
          </span>
        </div>
        {
          tags.length > 0 && (
            <ul class="article-tags" aria-label="文章标签">
              {tags.map((tag) => (
                <li>
                  <a href={`/tags/${encodeURIComponent(tag)}`} class="tag-pill font-mono">
                    #{tag}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </header>

      <hr class="article-divider" />

      {/* 正文 + 目录 */}
      <div class="article-grid">
        <div class="article-main">
          <TableOfContents headings={headings} variant="mobile" />
          <article class="prose">
            <Content />
          </article>
        </div>
        <aside class="article-aside">
          <TableOfContents headings={headings} variant="desktop" />
        </aside>
      </div>

      <PostNavigation prev={prev} next={next} />
    </FloatingMainCard>
  </div>
</BaseLayout>

<style>
  .article-stage {
    position: relative;
    height: clamp(200px, 32vw, 380px);
    background: var(--color-canvas);
    overflow: hidden;
  }

  .article-stage:not(.has-cover) {
    height: clamp(160px, 22vw, 240px);
  }

  .stage-backdrop {
    position: absolute;
    inset: 0;
  }

  .stage-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .stage-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, var(--color-overlay) 0%, transparent 35%, var(--color-canvas) 98%);
  }

  :global(html[data-theme='dark']) .stage-scrim {
    background: linear-gradient(to bottom, var(--color-overlay) 0%, rgba(23, 25, 22, 0.3) 45%, var(--color-canvas) 98%);
  }

  .article-wrap {
    position: relative;
    z-index: 10;
  }

  .article-card {
    max-width: 1080px;
  }

  .article-header {
    text-align: center;
    max-width: 760px;
    margin-inline: auto;
  }

  .article-breadcrumb {
    margin-bottom: 18px;
  }

  .crumb-category {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12.5px;
    letter-spacing: 0.05em;
    color: var(--color-contrast);
    padding: 4px 13px;
    background: var(--color-contrast-soft);
    border-radius: 999px;
  }

  .crumb-category:hover {
    color: var(--color-text);
  }

  .article-title {
    font-size: clamp(26px, 4.2vw, 38px);
    font-weight: 700;
    line-height: 1.4;
    color: var(--color-text);
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  .article-desc {
    margin: 16px auto 0;
    max-width: 620px;
    font-size: 15px;
    line-height: 1.8;
    color: var(--color-muted);
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 20px;
    margin-top: 20px;
    font-size: 12.5px;
    color: var(--color-muted);
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    list-style: none;
    margin-top: 18px;
  }

  .tag-pill {
    display: inline-block;
    max-width: 220px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding: 4px 12px;
    font-size: 12px;
    color: var(--color-muted);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .tag-pill:hover {
    color: var(--color-accent-text);
    border-color: var(--color-accent);
  }

  .article-divider {
    border: none;
    border-top: 1px solid var(--color-border);
    margin-block: clamp(28px, 4vw, 40px);
  }

  /* 正文 + 目录的网格:宽屏时目录在右侧 */
  .article-grid {
    display: block;
  }

  .article-aside {
    display: none;
  }

  @media (min-width: 1101px) {
    .article-grid {
      display: grid;
      grid-template-columns: minmax(0, var(--prose-max)) 200px;
      justify-content: center;
      gap: 64px;
    }

    .article-aside {
      display: block;
    }

    /* 宽屏时隐藏文章内的移动目录 */
    .article-main :global(.toc-mobile) {
      display: none;
    }
  }
</style>
