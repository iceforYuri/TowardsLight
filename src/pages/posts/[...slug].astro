---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FloatingMainCard from '../../components/FloatingMainCard.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import ImageLightbox from '../../components/ImageLightbox.astro';
import TocDrawer from '../../components/TocDrawer.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import PostNavigation from '../../components/PostNavigation.astro';
import Icon from '../../components/Icon.astro';
import { getAllPosts, formatDate, readingTime } from '../../utils/posts';
import { u } from '../../utils/url';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      prev: posts[i + 1], // 时间更早的一篇
      next: posts[i - 1], // 时间更晚的一篇
    },
  }));
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, pubDate, updatedDate, category, tags, cover, coverAlt, coverPosition } =
  post.data;
const minutes = readingTime(post.body ?? '');

/**
 * 封面双模式:
 * - `/images/...`(或 http)走 public/junction,原样引用
 * - 相对路径(如 image/my-post/cover.jpg)相对文章 .md 解析,经 Vite 资产管线输出
 */
const postAssets = import.meta.glob<string>(
  '../../profiles/active/posts/**/*.{png,jpg,jpeg,webp,avif,gif,svg}',
  { eager: true, query: '?url', import: 'default' },
);
let coverSrc: string | undefined;
if (cover) {
  if (cover.startsWith('/')) {
    coverSrc = u(cover);
  } else if (/^https?:/.test(cover)) {
    coverSrc = cover;
  } else {
    coverSrc = postAssets[`../../profiles/active/posts/${cover}`];
    if (!coverSrc) console.warn(`[posts] 封面文件不存在:posts/${cover}(${post.id})`);
  }
}
---

<BaseLayout title={title} description={description}>
  <ReadingProgress />

  {/* 文章顶部视觉区:有封面用封面,无封面用纯色 */}
  <section class:list={['article-stage', { 'has-cover': coverSrc }]}>
    {
      coverSrc && (
        <div class="stage-backdrop" aria-hidden="true" transition:name="stage-media">
          <img
            src={coverSrc}
            alt={coverAlt ?? ''}
            class="stage-img img-reveal"
            style={`object-position: ${coverPosition};`}
            loading="eager"
            onload="this.classList.add('is-loaded')"
            onerror="this.closest('.stage-backdrop')?.classList.add('is-broken'); this.remove()"
          />
          <div class="stage-scrim" />
        </div>
      )
    }
  </section>

  <div class="shell-container article-wrap">
    <div class="article-layout">
      <FloatingMainCard overlap="stage" class="article-card">
        {/* 文章头部 */}
        <header class="article-header">
          <div class="article-breadcrumb font-mono">
            <a href={u(`/categories/${encodeURIComponent(category)}`)} class="crumb-category">
              <Icon name="folder" size={13} />
              {category}
            </a>
          </div>
          <h1 class="article-title font-display" transition:name="page-title">{title}</h1>
          <p class="article-desc">{description}</p>
          <div class="article-meta font-mono">
            <span class="meta-item">
              <Icon name="calendar" size={13} />
              <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
            </span>
            {
              updatedDate && (
                <span class="meta-item">
                  <Icon name="refresh-cw" size={13} />
                  更新于 {formatDate(updatedDate)}
                </span>
              )
            }
            <span class="meta-item">
              <Icon name="clock" size={13} />
              约 {minutes} 分钟
            </span>
          </div>
          {
            tags.length > 0 && (
              <ul class="article-tags" aria-label="文章标签">
                {tags.map((tag) => (
                  <li>
                    <a href={u(`/tags/${encodeURIComponent(tag)}`)} class="tag-pill font-mono">
                      #{tag}
                    </a>
                  </li>
                ))}
              </ul>
            )
          }
        </header>

        <hr class="article-divider" />

        {/* 正文(目录已拆出卡片) */}
        <TableOfContents headings={headings} variant="mobile" />
        <article class="prose">
          <Content />
        </article>

        <PostNavigation prev={prev} next={next} />
      </FloatingMainCard>

      {/* 宽屏:目录外挂到卡片右侧的画布区 */}
      <aside class="article-aside">
        <TableOfContents headings={headings} variant="desktop" />
      </aside>
    </div>
  </div>

  {/* 中宽屏:侧边按钮 + 玻璃抽屉目录 */}
  <TocDrawer headings={headings} />

  {/* 正文图片点击放大 */}
  <ImageLightbox />
</BaseLayout>

<style>
  .article-stage {
    position: relative;
    height: clamp(200px, 32vw, 380px);
    background: var(--color-canvas);
    overflow: hidden;
  }

  .article-stage:not(.has-cover) {
    height: clamp(160px, 22vw, 240px);
  }

  .stage-backdrop {
    position: absolute;
    inset: 0;
  }

  .stage-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .stage-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, var(--color-overlay) 0%, transparent 35%, var(--color-canvas) 98%);
  }

  :global(html[data-theme='dark']) .stage-scrim {
    background: linear-gradient(to bottom, var(--color-overlay) 0%, rgba(23, 25, 22, 0.3) 45%, var(--color-canvas) 98%);
  }

  .article-wrap {
    position: relative;
    z-index: 10;
  }

  /* 卡片与其他页面同宽(跟随壳层),由子组件渲染需要 :global */
  :global(.article-card) {
    width: 100%;
  }

  /* 宽屏:整屏宽的卡片 + 外挂到更右侧的目录,组合居中 */
  .article-layout {
    display: block;
  }

  .article-aside {
    display: none;
  }

  @media (min-width: 1280px) {
    /* 放宽壳层:整屏宽卡片 + 64 间距 + 220 目录 + 内边距 */
    .shell-container.article-wrap {
      max-width: 1404px;
    }

    .article-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 220px;
      gap: 64px;
    }

    :global(.article-card) {
      max-width: none;
    }

    .article-aside {
      display: block;
      /* 与卡片的负 margin 重叠对齐,再上推一个卡片内边距 */
      margin-top: clamp(-72px, -5vw, -40px);
      padding-top: clamp(24px, 5vw, 56px);
    }

    /* 宽屏时隐藏文章内的移动目录 */
    :global(.article-card .toc-mobile) {
      display: none;
    }
  }

  /* 中宽屏(抽屉接管):隐藏卡内目录 */
  @media (min-width: 768px) and (max-width: 1279px) {
    :global(.article-card .toc-mobile) {
      display: none;
    }
  }

  .article-header {
    text-align: center;
    max-width: 760px;
    margin-inline: auto;
  }

  .article-breadcrumb {
    margin-bottom: 18px;
  }

  .crumb-category {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12.5px;
    letter-spacing: 0.05em;
    color: var(--color-contrast);
    padding: 4px 13px;
    background: var(--color-contrast-soft);
    border-radius: 999px;
  }

  .crumb-category:hover {
    color: var(--color-text);
  }

  .article-title {
    font-size: clamp(26px, 4.2vw, 38px);
    font-weight: 700;
    line-height: 1.4;
    color: var(--color-text);
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  .article-desc {
    margin: 16px auto 0;
    max-width: 620px;
    font-size: 15px;
    line-height: 1.8;
    color: var(--color-muted);
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 20px;
    margin-top: 20px;
    font-size: 12.5px;
    color: var(--color-muted);
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    list-style: none;
    margin-top: 18px;
  }

  .tag-pill {
    display: inline-block;
    max-width: 220px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding: 4px 12px;
    font-size: 12px;
    color: var(--color-muted);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .tag-pill:hover {
    color: var(--color-accent-text);
    border-color: var(--color-accent);
  }

  .article-divider {
    border: none;
    border-top: 1px solid var(--color-border);
    margin-block: clamp(28px, 4vw, 40px);
  }
</style>
