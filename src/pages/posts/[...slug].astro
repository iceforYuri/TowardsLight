---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FloatingMainCard from '../../components/FloatingMainCard.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import ImageLightbox from '../../components/ImageLightbox.astro';
import TocDrawer from '../../components/TocDrawer.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import PostNavigation from '../../components/PostNavigation.astro';
import Icon from '../../components/Icon.astro';
import { getAllPosts, formatDate, readingTime } from '../../utils/posts';
import { site } from '../../data/site';
import { u, stageMediaName } from '../../utils/url';
import { optImage } from '../../utils/opt-image';
import { imageTreatment, sampleImageLuminance } from '../../utils/image-luminance';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      prev: posts[i + 1], // 时间更早的一篇
      next: posts[i - 1], // 时间更晚的一篇
    },
  }));
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, pubDate, updatedDate, category, tags, cover, coverAlt, coverPosition } =
  post.data;
const minutes = readingTime(post.body ?? '');

/**
 * 封面双模式:
 * - `/images/...`(或 http)走 public/junction,原样引用
 * - 相对路径(如 image/my-post/cover.jpg)相对文章 .md 解析,经 Vite 资产管线输出
 */
const postAssets = import.meta.glob<string>(
  '../../profiles/active/posts/**/*.{png,jpg,jpeg,webp,avif,gif,svg}',
  { eager: true, query: '?url', import: 'default' },
);
let coverSrc: string | undefined;
if (cover) {
  if (cover.startsWith('/')) {
    coverSrc = u(optImage(cover));
  } else if (/^https?:/.test(cover)) {
    coverSrc = cover;
  } else {
    coverSrc = postAssets[`../../profiles/active/posts/${cover}`];
    if (!coverSrc) console.warn(`[posts] 封面文件不存在:posts/${cover}(${post.id})`);
  }
}

// 封面亮度采样:视觉区标题/介绍按"处理后亮度"选文字色与遮罩(见 utils/image-luminance)
const coverFsPath =
  cover && !/^https?:/.test(cover)
    ? cover.startsWith('/')
      ? cover
      : `src/profiles/active/posts/${cover}`
    : undefined;
const coverTreatment = imageTreatment(await sampleImageLuminance(coverFsPath, 'hero'));

// 分享卡片图与结构化数据(BlogPosting)
const ogImage = coverSrc ? new URL(coverSrc, Astro.site ?? Astro.url.origin).href : undefined;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
  author: { '@type': 'Person', name: site.author },
  ...(ogImage ? { image: ogImage } : {}),
  keywords: tags.join(', '),
  articleSection: category,
  inLanguage: 'zh-CN',
};
---

<BaseLayout title={title} description={description} type="article" image={ogImage} jsonLd={jsonLd}>
  <ReadingProgress />

  {/* 文章顶部视觉区:封面 + 居中的标题区;无封面时退化为纯色 + 标题 */}
  <section
    class:list={['article-stage', { 'has-cover': coverSrc }]}
    data-img-mode={coverSrc ? (coverTreatment?.mode ?? null) : null}
    style={
      coverTreatment
        ? `--img-scrim: ${coverTreatment.scrim}; --img-scrim-dark: ${coverTreatment.scrimDark}`
        : undefined
    }
  >
    {
      coverSrc && (
        <div class="stage-backdrop img-reveal" aria-hidden="true" transition:name={stageMediaName(coverSrc)}>
          <style is:global set:html={`::view-transition-group(${stageMediaName(coverSrc ?? '')}) { z-index: 1; }`} />
          <img
            src={coverSrc}
            alt={coverAlt ?? ''}
            class="stage-img"
            style={`object-position: ${coverPosition};`}
            loading="eager"
            decoding="async"
            onerror="this.closest('.stage-backdrop')?.classList.add('is-broken'); this.remove()"
          />
          <div class="stage-scrim" />
        </div>
      )
    }

    {/* 文章头部:标题、介绍、元信息居中于视觉区 */}
    <header class="article-header">
      <div class="article-breadcrumb font-mono">
        <a href={u(`/categories/${encodeURIComponent(category)}`)} class="crumb-category">
          <Icon name="folder" size={13} />
          {category}
        </a>
      </div>
      <h1 class="article-title font-display" transition:name="page-title">{title}</h1>
      <p class="article-desc">{description}</p>
      <div class="article-meta font-mono">
        <span class="meta-item">
          <Icon name="calendar" size={13} />
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        </span>
        {
          updatedDate && (
            <span class="meta-item">
              <Icon name="refresh-cw" size={13} />
              更新于 {formatDate(updatedDate)}
            </span>
          )
        }
        <span class="meta-item">
          <Icon name="clock" size={13} />
          约 {minutes} 分钟
        </span>
      </div>
      {
        tags.length > 0 && (
          <ul class="article-tags" aria-label="文章标签">
            {tags.map((tag) => (
              <li>
                <a href={u(`/tags/${encodeURIComponent(tag)}`)} class="tag-pill font-mono">
                  #{tag}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </header>
  </section>

  <div class="shell-container article-wrap">
    <div class="article-layout">
      <FloatingMainCard overlap="stage" class="article-card">
        {/* 正文(目录已拆出卡片) */}
        {/* 正文(目录已拆出卡片) */}
        <TableOfContents headings={headings} variant="mobile" />
        <article class="prose">
          <Content />
        </article>

        <PostNavigation prev={prev} next={next} />
      </FloatingMainCard>

      {/* 宽屏:目录外挂到卡片右侧的画布区 */}
      <aside class="article-aside">
        <TableOfContents headings={headings} variant="desktop" />
      </aside>
    </div>
  </div>

  {/* 中宽屏:侧边按钮 + 玻璃抽屉目录 */}
  <TocDrawer headings={headings} />

  {/* 正文图片点击放大 */}
  <ImageLightbox />
</BaseLayout>

<style>
  .article-stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    /* 高度由内容驱动,避免头部组溢出:上留导航位,下留卡片重叠缓冲 */
    min-height: clamp(360px, 46vw, 520px);
    padding: calc(var(--nav-height) + 56px) clamp(20px, 5vw, 48px) 128px;
    background: var(--color-canvas);
    overflow: hidden;
    /* 标题区文字色:默认取主题色,有封面时由 data-img-mode 覆盖 */
    --astg-fg: var(--color-text);
    --astg-fg-2: var(--color-accent-text);
    --astg-fg-m: var(--color-muted);
  }

  .article-stage:not(.has-cover) {
    min-height: clamp(280px, 34vw, 380px);
  }

  /* 图上文字模式(与 Hero/PageVisualStage 同一套,见 utils/image-luminance)。
     仅在背景真正揭示后套用(:has .is-loaded):图未到位时底下是主题画布色,
     图上浅字落在亮底上会隐形,看起来像"标题等图片淡入才显示" */
  .article-stage[data-img-mode='on-dark']:has(.stage-backdrop.is-loaded) {
    --astg-fg: #f2f3ec;
    --astg-fg-2: color-mix(in oklab, var(--color-accent) 50%, #ffffff);
    --astg-fg-m: rgba(242, 243, 236, 0.78);
  }

  .article-stage[data-img-mode='on-light']:has(.stage-backdrop.is-loaded) {
    --astg-fg: #1b1d1a;
    --astg-fg-2: color-mix(in oklab, var(--color-accent-text) 78%, #1b1d1a);
    --astg-fg-m: rgba(27, 29, 26, 0.74);
  }

  /* 深色主题:有封面一律收暗 + 浅字(同样等背景揭示后套用) */
  :global(html[data-theme='dark']) .article-stage[data-img-mode]:has(.stage-backdrop.is-loaded) {
    --astg-fg: #f2f3ec;
    --astg-fg-2: color-mix(in oklab, var(--color-accent) 50%, #ffffff);
    --astg-fg-m: rgba(242, 243, 236, 0.78);
  }

  /* 图到位/隐藏时,文字色随底色平滑过渡 */
  .article-title,
  .article-desc,
  .article-meta {
    transition: color 0.3s ease;
  }

  .stage-backdrop {
    position: absolute;
    inset: 0;
  }

  .stage-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .stage-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, var(--color-overlay) 0%, transparent 35%, var(--color-canvas) 98%);
  }

  :global(html[data-theme='dark']) .article-stage:not([data-img-mode]) .stage-scrim {
    background: linear-gradient(to bottom, var(--color-overlay) 0%, rgba(23, 25, 22, 0.3) 45%, var(--color-canvas) 98%);
  }

  /* 模式遮罩:文字居中,中段均压,底部溶入画布 */
  .article-stage[data-img-mode='on-dark'] .stage-scrim {
    background: linear-gradient(
      to bottom,
      rgba(18, 20, 17, calc(var(--img-scrim, 0.35) * 0.6)) 0%,
      rgba(18, 20, 17, var(--img-scrim, 0.35)) 45%,
      rgba(18, 20, 17, calc(var(--img-scrim, 0.35) * 0.8)) 68%,
      var(--color-canvas) 98%
    );
  }

  .article-stage[data-img-mode='on-light'] .stage-scrim {
    background: linear-gradient(
      to bottom,
      rgba(244, 245, 241, calc(var(--img-scrim, 0.35) * 0.5)) 0%,
      rgba(244, 245, 241, var(--img-scrim, 0.35)) 45%,
      rgba(244, 245, 241, calc(var(--img-scrim, 0.35) * 0.75)) 68%,
      var(--color-canvas) 98%
    );
  }

  :global(html[data-theme='dark']) .article-stage[data-img-mode] .stage-scrim {
    background: linear-gradient(
      to bottom,
      rgba(18, 20, 17, calc(var(--img-scrim-dark, 0.45) * 0.6)) 0%,
      rgba(18, 20, 17, var(--img-scrim-dark, 0.45)) 45%,
      rgba(18, 20, 17, calc(var(--img-scrim-dark, 0.45) * 0.8)) 68%,
      var(--color-canvas) 98%
    );
  }

  .article-wrap {
    position: relative;
    z-index: 10;
  }

  /* 卡片与其他页面同宽(跟随壳层),由子组件渲染需要 :global */
  :global(.article-card) {
    width: 100%;
  }

  /* 宽屏:整屏宽的卡片 + 外挂到更右侧的目录,组合居中 */
  .article-layout {
    display: block;
  }

  .article-aside {
    display: none;
  }

  @media (min-width: 1280px) {
    /* 放宽壳层:整屏宽卡片 + 64 间距 + 220 目录 + 内边距 */
    .shell-container.article-wrap {
      max-width: 1404px;
    }

    .article-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 220px;
      gap: 64px;
    }

    :global(.article-card) {
      max-width: none;
    }

    .article-aside {
      display: block;
      /* 与卡片的负 margin 重叠对齐,再上推一个卡片内边距 */
      margin-top: clamp(-72px, -5vw, -40px);
      padding-top: clamp(24px, 5vw, 56px);
    }

    /* 宽屏时隐藏文章内的移动目录 */
    :global(.article-card .toc-mobile) {
      display: none;
    }
  }

  /* 中宽屏(抽屉接管):隐藏卡内目录 */
  @media (min-width: 768px) and (max-width: 1279px) {
    :global(.article-card .toc-mobile) {
      display: none;
    }
  }

  .article-header {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 760px;
    margin-inline: auto;
  }

  .article-breadcrumb {
    margin-bottom: 18px;
  }

  .crumb-category {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-sm);
    font-weight: var(--weight-label);
    letter-spacing: 0.05em;
    color: var(--color-contrast);
    padding: 4px 13px;
    background: var(--color-contrast-soft);
    border-radius: 999px;
  }

  .crumb-category:hover {
    color: var(--color-text);
  }

  .article-title {
    font-size: clamp(30px, 5vw, 44px);
    font-weight: 700;
    line-height: 1.4;
    color: var(--astg-fg, var(--color-text));
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  .article-desc {
    margin: 16px auto 0;
    max-width: 620px;
    font-size: var(--text-lg);
    line-height: 1.8;
    color: var(--astg-fg-m, var(--color-muted));
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 20px;
    margin-top: 20px;
    font-size: var(--text-sm);
    font-weight: var(--weight-label);
    color: var(--astg-fg-m, var(--color-muted));
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    list-style: none;
    margin-top: 18px;
  }

  .tag-pill {
    display: inline-block;
    max-width: 220px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding: 4px 12px;
    font-size: var(--text-sm);
    font-weight: var(--weight-label);
    color: var(--color-muted);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .tag-pill:hover {
    color: var(--color-accent-text);
    border-color: var(--color-accent);
  }

</style>
