---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageVisualStage from '../components/PageVisualStage.astro';
import FloatingMainCard from '../components/FloatingMainCard.astro';
import TechLinkDirectory from '../components/TechLinkDirectory.astro';
import { site } from '../data/site';
import { techLinks } from '../data/links';
---

<BaseLayout title="Links" description={`${site.author} 常用的工具、社区和去处`}>
  <PageVisualStage
    title="链接"
    description="我常用的工具、常去的社区、认可的平台。不是导航站，是个人选择。"
    image={site.pageBackdrops.links || undefined}
    meta={`${techLinks.length} 个链接 · 持续更新`}
  />
  <div class="shell-container">
    <FloatingMainCard overlap="stage">
      <TechLinkDirectory />
    </FloatingMainCard>
  </div>
</BaseLayout>
