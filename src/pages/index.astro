---
import BaseLayout from '../layouts/BaseLayout.astro';
import CenteredHero from '../components/CenteredHero.astro';
import FloatingMainCard from '../components/FloatingMainCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import PostList from '../components/PostList.astro';
import FlipRow from '../components/FlipRow.astro';
import TechLinkCard from '../components/TechLinkCard.astro';
import Icon from '../components/Icon.astro';
import { getAllPosts, formatDate, countWords, collectTags } from '../utils/posts';
import { u, stageMediaName } from '../utils/url';
import { optImage } from '../utils/opt-image';
import { site } from '../data/site';
import { linkGroups, techLinks } from '../data/links';
import { resolveImgMode } from '../utils/image-luminance';

const posts = await getAllPosts();

// 首页结构化数据(WebSite)
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.siteName,
  description: site.bio,
  inLanguage: 'zh-CN',
};
const recentPosts = posts.slice(0, 5);
// 首页「常用去处」:读独立的 home 字段(featured 只管 Links 页卡片形态),最多 3 个
const homeLinks = techLinks.filter((l) => l.home).slice(0, 3);
// 精选卡跟随所在分组的整组色调(分组没配 tone 则保持默认珊瑚)
const groupTone = new Map(linkGroups.map((g) => [g.id, 'tone' in g ? g.tone : undefined]));
// 统计行与身份组共用同一图上文字模式;壁纸层也挂在 .home-flow(采样有缓存,重复调用廉价)
const hero = site.homeHero;
const { imgMode, imgScrim, imgScrimDark } = await resolveImgMode(hero.background, hero.textMode, 'hero');

// Hero 统计行:全部由内容集合在构建时算出;数字段经过打字光标时翻动计数
type StatSegment = { t: 'text'; v: string } | { t: 'num'; v: number; d?: number };
const firstPost = posts[posts.length - 1];
const firstDate = firstPost ? formatDate(firstPost.data.pubDate) : '';
const dayCount = firstPost
  ? Math.max(1, Math.floor((Date.now() - firstPost.data.pubDate.getTime()) / 86400000) + 1)
  : 0;
const totalChars = posts.reduce((sum, p) => sum + countWords(p.body ?? ''), 0);
const tagCount = collectTags(posts).size;
const statsSegments: StatSegment[] = firstPost
  ? [
      { t: 'text', v: `自 ${firstDate} 的第一篇起 · 已写 ` },
      { t: 'num', v: dayCount },
      { t: 'text', v: ' 天 · ' },
      { t: 'num', v: posts.length },
      { t: 'text', v: ' 篇文章 · ' },
      ...(totalChars >= 10000
        ? ([
            { t: 'text', v: '约 ' },
            { t: 'num', v: Math.round(totalChars / 1000) / 10, d: 1 },
            { t: 'text', v: ' 万字 · ' },
          ] as StatSegment[])
        : ([
            { t: 'text', v: '共 ' },
            { t: 'num', v: totalChars },
            { t: 'text', v: ' 字 · ' },
          ] as StatSegment[])),
      { t: 'num', v: tagCount },
      { t: 'text', v: ' 个标签' },
    ]
  : [{ t: 'text', v: '还没有文章，敬请期待' }];
---

{/*
  v2 规格(docs/specs/2026-10-03-home-wallpaper-hero.md):
  .home-flow > 壁纸层(sticky 冻结) + hero(身份组) + 统计行(三态纯文字)
           + .home-body(羽化幕布) > 主卡片
*/}
<BaseLayout jsonLd={jsonLd}>
  <div
    class="home-flow"
    data-img-mode={imgMode}
    style={imgMode ? `--img-scrim: ${imgScrim}; --img-scrim-dark: ${imgScrimDark}` : undefined}
  >
    {/* 壁纸层:在 .home-flow 直属——sticky 冻结需要"轨道+一屏"的容器,
        hero 不够高。轨道高度 = 100svh + L(锁底脚本写入),负 margin 抵消占位;
        壁纸层 sticky top:0:行程内被轨道钳在视口(冻结),行程外停在轨道末随文档滚动 */}
    {
      hero.background && (
        <div class="wallpaper-track">
          <div class="hero-backdrop img-reveal" aria-hidden="true" transition:name={stageMediaName(hero.background)}>
            {/* 转场图层序:背景组始终压在卡片之下(转场名按图区分,见 utils/url) */}
            <style is:global set:html={`::view-transition-group(${stageMediaName(hero.background)}) { z-index: 1; }`} />
            <img
              src={u(optImage(hero.background))}
              alt=""
              class="hero-img"
              loading="eager"
              decoding="async"
              fetchpriority="high"
              onerror="this.closest('.hero-backdrop').remove()"
            />
            <div class="hero-scrim" />
          </div>
        </div>
      )
    }

    <CenteredHero />

    {/* 统计行:无背景纯文字,负 margin 骑入 hero 底缘重叠区(界锚=主卡片顶部);
        上滚出视口底时被 sticky 收在底缘,读卡片时滚出视口消失。
        打字机由 CenteredHero 的脚本统一驱动(.hero-stats 选择器) */}
    <p class="hero-stats font-mono" data-typewriter>
      <span data-typewriter-text>{
        statsSegments.map((seg) =>
          seg.t === 'num' ? (
            <span class="type-num" data-count-to={seg.v} data-decimals={seg.d ?? 0}>{seg.d ? seg.v.toFixed(seg.d) : seg.v}</span>
          ) : (
            <>{seg.v}</>
          ),
        )
      }</span><span class="type-caret" data-typewriter-caret aria-hidden="true">_</span>
    </p>

    {/* 羽化幕布:透明→画布色渐变(顶部 200px 羽化段)接续纯画布色,
        锚定卡片顶、随卡片滚动;上滚到顶时整幅离场,壁纸完整无羽化 */}
    <div class="home-body">
      <div class="shell-container home-card-wrap">
        <FloatingMainCard overlap="none">
        {/* 个人介绍 */}
        <section class="home-intro">
          <img
            decoding="async"
            src={u(site.avatar)}
            alt={`${site.author} 的头像`}
            class="intro-avatar"
            width="64"
            height="64"
            style={`object-position: ${site.avatarPosition};`}
            onerror="this.style.display='none'"
          />
          <div class="intro-body">
            <p class="intro-name font-display">{site.author}</p>
            <p class="intro-bio">{site.bio}</p>
            <FlipRow />
          </div>
        </section>

        <hr class="home-divider" />

        {/* 近期文章 */}
        <section>
          <SectionHeader title="近期文章" count={posts.length} href={u('/archive')} linkText="归档" />
          <PostList posts={recentPosts} />
        </section>

        <hr class="home-divider" />

        {/* 精选技术链接 */}
        <section>
          <SectionHeader title="常用去处" href={u('/links')} linkText="完整目录" />
          <div class="featured-links">
            {homeLinks.map((link) => <TechLinkCard link={link} tone={groupTone.get(link.group)} />)}
          </div>
        </section>

        <hr class="home-divider" />

        {/* 联系与订阅 */}
        <section class="home-contact">
          <p class="contact-text">
            文章通过 <a href={u('/rss.xml')}>RSS</a> 发布更新，也欢迎邮件交流:
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </p>
          <a href={u('/archive')} class="contact-cta font-ui">
            浏览全部文章 <Icon name="arrow-right" size={15} />
          </a>
        </section>
      </FloatingMainCard>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .home-flow {
    position: relative;
    /* 阻隔壁纸层 margin 与外部的折叠(margin collapse),保证其自然位置精确 */
    display: flow-root;
  }

  /* 壁纸轨道:高度 = 100svh + L(锁底脚本写入),负 margin 抵消文档流占位。
     L=0(未锁底/移动端)时轨道=一屏,壁纸层无钳制空间,自动等价纯随动 */
  .wallpaper-track {
    height: 100svh;
    margin-bottom: calc(-1 * 100svh);
    pointer-events: none;
  }

  /* 壁纸层:恰好一屏高(图片永按视口比例缩放)。sticky top 冻结:
     行程内(scrollY<L)被轨道钳在视口顶 → 满屏不动;
     行程外(scrollY≥L)停在轨道末,随文档一体上移。
     纯 CSS 合成器行为,无 JS 逐帧补偿(JS 补偿在合成器滚动下晚一帧,会剧烈抖动) */
  .hero-backdrop {
    position: sticky;
    top: 0;
    height: 100svh;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* 顶部导航保护 + 文字区压暗;底部画布羽化已移交羽化幕布(.home-body) */
  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, var(--color-overlay) 0%, transparent 28%);
  }

  /* 深色主题兜底:仅在采样失败(无 data-img-mode)时上段再压一层 */
  :global(html[data-theme='dark']) .home-flow:not([data-img-mode]) .hero-scrim {
    background: linear-gradient(
      to bottom,
      var(--color-overlay) 0%,
      rgba(23, 25, 22, 0.42) 40%,
      rgba(23, 25, 22, 0.55) 70%
    );
  }

  .home-flow[data-img-mode='on-dark'] .hero-scrim {
    background: linear-gradient(
      to bottom,
      rgba(18, 20, 17, calc(var(--img-scrim, 0.35) * 0.7)) 0%,
      rgba(18, 20, 17, var(--img-scrim, 0.35)) 42%,
      rgba(18, 20, 17, calc(var(--img-scrim, 0.35) * 0.85)) 68%
    );
  }

  .home-flow[data-img-mode='on-light'] .hero-scrim {
    background: linear-gradient(
      to bottom,
      rgba(244, 245, 241, calc(var(--img-scrim, 0.35) * 0.55)) 0%,
      rgba(244, 245, 241, var(--img-scrim, 0.35)) 42%,
      rgba(244, 245, 241, calc(var(--img-scrim, 0.35) * 0.8)) 68%
    );
  }

  :global(html[data-theme='dark']) .home-flow[data-img-mode] .hero-scrim {
    background: linear-gradient(
      to bottom,
      rgba(18, 20, 17, calc(var(--img-scrim-dark, 0.45) * 0.7)) 0%,
      rgba(18, 20, 17, var(--img-scrim-dark, 0.45)) 42%,
      rgba(18, 20, 17, calc(var(--img-scrim-dark, 0.45) * 0.85)) 68%
    );
  }

  /* 统计行:三态纯文字。负 margin 骑入卡片对 hero 的重叠区(重叠量与
     FloatingMainCard overlap-hero 同式);天然位置在视口底之下时被
     sticky 收在底缘;天然位置滚出视口上缘时正常离场。
     它始终压在壁纸上,壁纸揭示后文字色切换为图上模式 */
  .hero-stats {
    position: sticky;
    bottom: 12px;
    z-index: 11; /* 压过幕布与卡片 */
    display: block;
    width: fit-content;
    max-width: 88%;
    margin: calc(-1 * clamp(48px, 6vw, 96px)) auto 0;
    font-size: var(--text-sm);
    font-weight: var(--weight-label);
    letter-spacing: 0.03em;
    line-height: 1.8;
    text-align: center;
    color: var(--color-muted);
    transition: color 0.3s ease;
  }

  .hero-stats .type-num,
  .hero-stats .type-caret {
    color: var(--color-accent-text);
  }

  /* 壁纸揭示后(:has .is-loaded),统计行切换到图上文字色(与 hero 同体系) */
  .home-flow[data-img-mode='on-dark']:has(.hero-backdrop.is-loaded) .hero-stats {
    color: rgba(242, 243, 236, 0.74);
  }

  .home-flow[data-img-mode='on-dark']:has(.hero-backdrop.is-loaded) .hero-stats :is(.type-num, .type-caret) {
    color: color-mix(in oklab, var(--color-accent) 50%, #ffffff);
  }

  .home-flow[data-img-mode='on-light']:has(.hero-backdrop.is-loaded) .hero-stats {
    color: rgba(27, 29, 26, 0.74);
  }

  .home-flow[data-img-mode='on-light']:has(.hero-backdrop.is-loaded) .hero-stats :is(.type-num, .type-caret) {
    color: color-mix(in oklab, var(--color-accent-text) 78%, #1b1d1a);
  }

  :global(html[data-theme='dark']) .home-flow[data-img-mode]:has(.hero-backdrop.is-loaded) .hero-stats {
    color: rgba(242, 243, 236, 0.74);
  }

  :global(html[data-theme='dark']) .home-flow[data-img-mode]:has(.hero-backdrop.is-loaded) .hero-stats :is(.type-num, .type-caret) {
    color: color-mix(in oklab, var(--color-accent) 50%, #ffffff);
  }

  /* 羽化幕布:全宽,背景渐变先羽化(透明→画布)后纯色;页脚方向由 padding 承担间距,
     footer 的 margin-top 在首页归零,保证画布色不间断盖到页脚 */
  .home-body {
    position: relative;
    z-index: 10;
    background: linear-gradient(to bottom, transparent, var(--color-canvas) 200px);
    padding-bottom: 96px;
  }

  :global(body:has(.home-flow) .site-footer) {
    margin-top: 0;
  }

  /* 重叠量由统计行的负 margin 承载;卡片上间距 24px = 统计行与卡片的呼吸距离
     (锁底脚本会自动吸收:hero 高度相应减少,卡片顶仍恒等于一屏) */
  .home-card-wrap :global(.overlap-none) {
    margin-top: 24px;
  }

  .home-intro {
    display: flex;
    gap: 22px;
    align-items: flex-start;
  }

  .intro-avatar {
    width: 64px;
    height: 64px;
    /* 圆角方形，与卡片同一圆角语言 */
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    flex-shrink: 0;
    /* 任意比例的原图都居中裁切成正方形，不变形 */
    object-fit: cover;
  }

  .intro-body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }

  .intro-name {
    font-size: 22px;
    font-weight: 700;
    color: var(--color-text);
  }

  .intro-bio {
    font-size: var(--text-lg);
    line-height: 1.8;
    color: var(--color-muted);
  }

  .home-divider {
    border: none;
    border-top: 1px solid var(--color-border);
    margin-block: clamp(28px, 4vw, 40px);
  }

  .featured-links {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 14px;
    margin-top: 16px;
  }

  /* 只有 1~2 张卡时限制最大宽度,避免单卡拉伸整行 */
  .featured-links:has(> :first-child:last-child),
  .featured-links:has(> :nth-child(2):last-child) {
    grid-template-columns: repeat(auto-fill, minmax(240px, 340px));
  }

  .home-contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }

  .contact-text {
    font-size: var(--text-lg);
    color: var(--color-muted);
  }

  .contact-cta {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 10px 20px;
    font-size: var(--text-md);
    font-weight: 500;
    color: var(--color-surface);
    background: var(--color-text);
    border-radius: 999px;
    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }

  .contact-cta:hover {
    transform: translateY(-1px);
    opacity: 0.9;
    color: var(--color-surface);
  }

  @media (max-width: 640px) {
    .home-intro {
      flex-direction: column;
      gap: 16px;
    }

    /* 移动端卡片重叠量为 28px */
    .hero-stats {
      margin-top: -28px;
    }
  }
</style>

<script>
  /**
   * 横线锁底 + 进入偏移(v2 规格):
   * - 锁底:调整 hero 高度,使卡片顶缘文档位置恒等于视口高——
   *   由此页顶(scrollY=0)即满屏壁纸态停止位,构造保证无 overshoot;
   * - 壁纸冻结:壁纸层 sticky bottom,其自然位置经 margin 放在 [L, L+100svh]——
   *   行程内被钳到满屏(冻结),行程外随文档滚动;L=0 时自然位置 [0,100svh],
   *   自动等价纯随动;
   * - 身份组对齐:按实测 L/重叠量/统计行高反推 hero-content 上padding,
   *   使组在 S0 可见区(视口顶~卡片顶)光学中心偏下 20px(贴向卡片、留出壁纸呼吸)——
   *   不同档案的简介高度不同,固定 padding 无法兼顾;
   * - 进入偏移 L = 卡片顶缘 → 简介线底缘的距离,进入时瞬时滚过 L,
   *   简介线恰好压在视口底缘;
   * - 内容(翻牌/换行/字体)或视口变化时重锁;锁底不可达(内容超高)时自然流;
   * - 移动端(≤640px):停用锁底与进入偏移,自然流(满屏壁纸入场);
   * - reload / 浏览器返回:交给滚动恢复,不干预。
   */
  function entryOffset(): number {
    const card = document.querySelector<HTMLElement>('.home-card-wrap .main-card');
    const divider = document.querySelector<HTMLElement>('.home-card-wrap .home-divider');
    if (!card || !divider) return 0;
    return Math.max(
      0,
      Math.round(divider.getBoundingClientRect().bottom - card.getBoundingClientRect().top),
    );
  }

  function lockHeroDivider(): boolean {
    const hero = document.querySelector<HTMLElement>('.hero');
    const content = document.querySelector<HTMLElement>('.hero-content');
    const card = document.querySelector<HTMLElement>('.home-card-wrap .main-card');
    const stats = document.querySelector<HTMLElement>('.hero-stats');
    if (!hero || !content || !card || !stats) return false;
    hero.style.minHeight = '';
    content.style.paddingTop = '';
    // 壁纸冻结行程:轨道高度 = 100svh + L(负 margin 抵消占位);
    // 未锁底时 L=0,壁纸层无钳制空间(不冻结,纯随动)
    const track = document.querySelector<HTMLElement>('.wallpaper-track');
    const setJourney = (v: number) => {
      if (!track) return;
      track.style.height = `calc(100svh + ${Math.round(v)}px)`;
      track.style.marginBottom = `calc(-100svh - ${Math.round(v)}px)`;
    };
    // 移动端放不下完整编排:自然流(满屏壁纸入场)
    if (window.matchMedia('(max-width: 640px)').matches) {
      setJourney(0);
      return false;
    }
    const cardTopDoc = card.getBoundingClientRect().top + window.scrollY;
    const delta = window.innerHeight - cardTopDoc;
    // 卡片顶已在一屏之下:锁底不可达,自然流
    if (delta <= 0) {
      setJourney(0);
      return false;
    }
    hero.style.minHeight = `${Math.round(hero.offsetHeight + delta)}px`;
    // 身份组对准 S0 可见区光学中心偏下:padTop = L − 重叠量 + 统计行高 + 偏下量 20
    // (下限 88 保证不与导航相碰;仍须低于 sticky 钳制线,否则进入态就误触发钉住/发光)
    const L = entryOffset();
    const statsH = stats.offsetHeight;
    const overlap = -parseFloat(getComputedStyle(stats).marginTop) || 0;
    content.style.paddingTop = `${Math.max(88, Math.round(L - overlap + statsH + 20))}px`;
    setJourney(L);
    // 身份组位置已变,通知发光编排重测钳制点
    document.dispatchEvent(new CustomEvent('hero:locked'));
    return true;
  }

  function scrollToEntry() {
    if (lockHeroDivider()) {
      window.scrollTo({ top: entryOffset(), behavior: 'instant' });
    }
  }

  let lockRaf = 0;
  function scheduleLock() {
    cancelAnimationFrame(lockRaf);
    lockRaf = requestAnimationFrame(() => lockHeroDivider());
  }

  let observedIntro: Element | null = null;
  const introObserver = new ResizeObserver(scheduleLock);

  function initHeroLock() {
    lockHeroDivider();
    const intro = document.querySelector('.home-intro');
    if (intro && intro !== observedIntro) {
      observedIntro = intro;
      introObserver.observe(intro);
    }
  }

  initHeroLock();
  // 硬加载且为全新进入(非浏览器返回):先锁底再偏移(此时整页已解析,不会被钳制);
  // 软导航来到首页时脚本首次执行,navDir 由转场标记,返回则不偏移
  const navType = (performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined)?.type;
  if (navType === 'navigate' && document.documentElement.dataset.navDir !== 'back') {
    scrollToEntry();
  }
  document.addEventListener('astro:after-swap', () => {
    initHeroLock();
    if (document.documentElement.dataset.navDir === 'back') return;
    scrollToEntry();
  });
  document.addEventListener('astro:page-load', scheduleLock);
  window.addEventListener('resize', scheduleLock);
  document.fonts?.ready.then(scheduleLock);
</script>
