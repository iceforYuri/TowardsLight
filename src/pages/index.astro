---
import BaseLayout from '../layouts/BaseLayout.astro';
import CenteredHero from '../components/CenteredHero.astro';
import FloatingMainCard from '../components/FloatingMainCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import PostList from '../components/PostList.astro';
import FlipRow from '../components/FlipRow.astro';
import TechLinkCard from '../components/TechLinkCard.astro';
import Icon from '../components/Icon.astro';
import { getAllPosts, formatDate, countWords, collectTags } from '../utils/posts';
import { u } from '../utils/url';
import { site } from '../data/site';
import { linkGroups, techLinks } from '../data/links';

const posts = await getAllPosts();
const recentPosts = posts.slice(0, 5);
// 首页精选链接:所有 featured,数量由勾选控制(策展纪律:建议 ≤ 4,多了首页会肿)
const featuredLinks = techLinks.filter((l) => l.featured);
// 精选卡跟随所在分组的整组色调(分组没配 tone 则保持默认珊瑚)
const groupTone = new Map(linkGroups.map((g) => [g.id, 'tone' in g ? g.tone : undefined]));

// Hero 统计行:全部由内容集合在构建时算出;数字段经过打字光标时翻动计数
type StatSegment = { t: 'text'; v: string } | { t: 'num'; v: number; d?: number };
const firstPost = posts[posts.length - 1];
const firstDate = firstPost ? formatDate(firstPost.data.pubDate) : '';
const dayCount = firstPost
  ? Math.max(1, Math.floor((Date.now() - firstPost.data.pubDate.getTime()) / 86400000) + 1)
  : 0;
const totalChars = posts.reduce((sum, p) => sum + countWords(p.body ?? ''), 0);
const tagCount = collectTags(posts).size;
const statsSegments: StatSegment[] = firstPost
  ? [
      { t: 'text', v: `自 ${firstDate} 的第一篇起 · 已写 ` },
      { t: 'num', v: dayCount },
      { t: 'text', v: ' 天 · ' },
      { t: 'num', v: posts.length },
      { t: 'text', v: ' 篇文章 · ' },
      ...(totalChars >= 10000
        ? ([
            { t: 'text', v: '约 ' },
            { t: 'num', v: Math.round(totalChars / 1000) / 10, d: 1 },
            { t: 'text', v: ' 万字 · ' },
          ] as StatSegment[])
        : ([
            { t: 'text', v: '共 ' },
            { t: 'num', v: totalChars },
            { t: 'text', v: ' 字 · ' },
          ] as StatSegment[])),
      { t: 'num', v: tagCount },
      { t: 'text', v: ' 个标签' },
    ]
  : [{ t: 'text', v: '还没有文章，敬请期待' }];
---

<BaseLayout>
  <CenteredHero statsSegments={statsSegments} />

  <div class="shell-container home-card-wrap">
    <FloatingMainCard overlap="hero">
      {/* 个人介绍 */}
      <section class="home-intro">
        <img
          decoding="async"
          src={u(site.avatar)}
          alt={`${site.author} 的头像`}
          class="intro-avatar"
          width="64"
          height="64"
          style={`object-position: ${site.avatarPosition};`}
          onerror="this.style.display='none'"
        />
        <div class="intro-body">
          <p class="intro-name font-display">{site.author}</p>
          <p class="intro-bio">{site.bio}</p>
          <FlipRow />
        </div>
      </section>

      <hr class="home-divider" />

      {/* 近期文章 */}
      <section>
        <SectionHeader title="近期文章" count={posts.length} href={u('/archive')} linkText="归档" />
        <PostList posts={recentPosts} />
      </section>

      <hr class="home-divider" />

      {/* 精选技术链接 */}
      <section>
        <SectionHeader title="常用去处" href={u('/links')} linkText="完整目录" />
        <div class="featured-links">
          {featuredLinks.map((link) => <TechLinkCard link={link} tone={groupTone.get(link.group)} />)}
        </div>
      </section>

      <hr class="home-divider" />

      {/* 联系与订阅 */}
      <section class="home-contact">
        <p class="contact-text">
          文章通过 <a href={u('/rss.xml')}>RSS</a> 发布更新，也欢迎邮件交流:
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
        <a href={u('/archive')} class="contact-cta font-ui">
          浏览全部文章 <Icon name="arrow-right" size={15} />
        </a>
      </section>
    </FloatingMainCard>
  </div>
</BaseLayout>

<style>
  .home-card-wrap {
    position: relative;
    z-index: 10;
  }

  .home-intro {
    display: flex;
    gap: 22px;
    align-items: flex-start;
  }

  .intro-avatar {
    width: 64px;
    height: 64px;
    /* 圆角方形，与卡片同一圆角语言 */
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    flex-shrink: 0;
    /* 任意比例的原图都居中裁切成正方形，不变形 */
    object-fit: cover;
  }

  .intro-body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }

  .intro-name {
    font-size: 22px;
    font-weight: 700;
    color: var(--color-text);
  }

  .intro-bio {
    font-size: 15px;
    line-height: 1.8;
    color: var(--color-muted);
  }

  .home-divider {
    border: none;
    border-top: 1px solid var(--color-border);
    margin-block: clamp(28px, 4vw, 40px);
  }

  .featured-links {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 14px;
    margin-top: 16px;
  }

  /* 只有 1~2 张卡时限制最大宽度,避免单卡拉伸整行 */
  .featured-links:has(> :first-child:last-child),
  .featured-links:has(> :nth-child(2):last-child) {
    grid-template-columns: repeat(auto-fill, minmax(240px, 340px));
  }

  .home-contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }

  .contact-text {
    font-size: 14.5px;
    color: var(--color-muted);
  }

  .contact-cta {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 10px 20px;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-surface);
    background: var(--color-text);
    border-radius: 999px;
    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }

  .contact-cta:hover {
    transform: translateY(-1px);
    opacity: 0.9;
    color: var(--color-surface);
  }

  @media (max-width: 640px) {
    .home-intro {
      flex-direction: column;
      gap: 16px;
    }
  }
</style>
