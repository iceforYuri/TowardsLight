---
import BaseLayout from '../layouts/BaseLayout.astro';
import CenteredHero from '../components/CenteredHero.astro';
import FloatingMainCard from '../components/FloatingMainCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import PostList from '../components/PostList.astro';
import StackStatus from '../components/StackStatus.astro';
import TechLinkCard from '../components/TechLinkCard.astro';
import Icon from '../components/Icon.astro';
import { getAllPosts, formatDate } from '../utils/posts';
import { site } from '../data/site';
import { techLinks } from '../data/links';

const posts = await getAllPosts();
const recentPosts = posts.slice(0, 5);
const latestDate = posts.length > 0 ? formatDate(posts[0].data.pubDate) : undefined;
const featuredLinks = techLinks.filter((l) => l.featured).slice(0, 3);
---

<BaseLayout>
  <CenteredHero postCount={posts.length} latestDate={latestDate} />

  <div class="shell-container home-card-wrap">
    <FloatingMainCard overlap="hero">
      {/* 个人介绍 */}
      <section class="home-intro">
        <img
          src={site.avatar}
          alt={`${site.author} 的头像`}
          class="intro-avatar"
          width="64"
          height="64"
          onerror="this.style.display='none'"
        />
        <div class="intro-body">
          <p class="intro-name font-display">{site.author}</p>
          <p class="intro-bio">{site.bio}</p>
          <StackStatus />
        </div>
      </section>

      <hr class="home-divider" />

      {/* 近期文章 */}
      <section>
        <SectionHeader title="近期文章" count={posts.length} href="/archive" linkText="归档" />
        <PostList posts={recentPosts} />
      </section>

      <hr class="home-divider" />

      {/* 精选技术链接 */}
      <section>
        <SectionHeader title="常用去处" href="/links" linkText="完整目录" />
        <div class="featured-links">
          {featuredLinks.map((link) => <TechLinkCard link={link} />)}
        </div>
      </section>

      <hr class="home-divider" />

      {/* 联系与订阅 */}
      <section class="home-contact">
        <p class="contact-text">
          文章通过 <a href="/rss.xml">RSS</a> 发布更新,也欢迎邮件交流:
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
        <a href="/archive" class="contact-cta font-ui">
          浏览全部文章 <Icon name="arrow-right" size={15} />
        </a>
      </section>
    </FloatingMainCard>
  </div>
</BaseLayout>

<style>
  .home-card-wrap {
    position: relative;
    z-index: 10;
  }

  .home-intro {
    display: flex;
    gap: 22px;
    align-items: flex-start;
  }

  .intro-avatar {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    flex-shrink: 0;
  }

  .intro-body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }

  .intro-name {
    font-size: 22px;
    font-weight: 700;
    color: var(--color-text);
  }

  .intro-bio {
    font-size: 15px;
    line-height: 1.8;
    color: var(--color-muted);
    max-width: 640px;
  }

  .home-divider {
    border: none;
    border-top: 1px solid var(--color-border);
    margin-block: clamp(28px, 4vw, 40px);
  }

  .featured-links {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 14px;
    margin-top: 16px;
  }

  .home-contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }

  .contact-text {
    font-size: 14.5px;
    color: var(--color-muted);
  }

  .contact-cta {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 10px 20px;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-surface);
    background: var(--color-text);
    border-radius: 999px;
    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }

  .contact-cta:hover {
    transform: translateY(-1px);
    opacity: 0.9;
    color: var(--color-surface);
  }

  @media (max-width: 640px) {
    .home-intro {
      flex-direction: column;
      gap: 16px;
    }
  }
</style>
