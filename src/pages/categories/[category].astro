---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageVisualStage from '../../components/PageVisualStage.astro';
import FloatingMainCard from '../../components/FloatingMainCard.astro';
import PostList from '../../components/PostList.astro';
import { getAllPosts, collectCategories } from '../../utils/posts';
import { site } from '../../data/site';
import { u } from '../../utils/url';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  const categories = collectCategories(posts);
  return [...categories.entries()].map(([category, list]) => ({
    params: { category },
    props: { category, posts: list },
  }));
}

const { category, posts } = Astro.props;
---

<BaseLayout title={`分类 · ${category}`} description={`分类「${category}」下的所有文章`}>
  <PageVisualStage
    title={category}
    image={site.pageBackdrops.categories || undefined}
    meta={`${posts.length} 篇文章`}
  />
  <div class="shell-container">
    <FloatingMainCard overlap="stage">
      <PostList posts={posts} showUpdated />
      <p class="back-line">
        <a href={u('/categories')}>← 返回所有分类</a>
      </p>
    </FloatingMainCard>
  </div>
</BaseLayout>

<style>
  .back-line {
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--color-border);
    font-size: 14px;
  }
</style>
