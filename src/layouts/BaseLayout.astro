---
import { ClientRouter } from 'astro:transitions';
import FloatingCenteredHeader from '../components/FloatingCenteredHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SearchOverlay from '../components/SearchOverlay.astro';
import { site } from '../data/site';
import { u } from '../utils/url';
import 'katex/dist/katex.min.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** 分享卡片图(绝对或站内路径);缺省用 Hero 背景(仅限位图,SVG 分享平台不认) */
  image?: string;
  /** 页面类型:文章页传 'article' */
  type?: 'website' | 'article';
  /** 结构化数据(schema.org),序列化后内联 */
  jsonLd?: Record<string, unknown>;
}

const { title, description = site.bio, image, type = 'website', jsonLd } = Astro.props;
const pageTitle = title ? `${title} · ${site.siteName}` : `${site.siteName} · ${site.shortBio}`;

// canonical/OG 一律绝对地址;Astro.url 已含 base
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const heroBg = site.homeHero?.background;
const defaultImage =
  heroBg && /\.(png|jpe?g|webp|avif)$/i.test(heroBg) ? heroBg : undefined;
const rawImage = image ?? defaultImage;
const ogImage = rawImage
  ? new URL(rawImage, Astro.site ?? Astro.url.origin).href
  : undefined;
---

<!doctype html>
<html lang="zh-CN" data-default-theme={site.themeDefault}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- 发现与分享:canonical 归权,OG/Twitter 供分享卡片 -->
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content={site.siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <link rel="icon" type="image/svg+xml" href={u('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={site.siteName} href={u('/rss.xml')} />

    <!-- 字体:自托管 + TL 别名族名(scripts/fetch-fonts.mjs 生成),
         防本地同名可变字体劫持字重;font-display: swap,失败回退系统字体栈 -->
    <link rel="stylesheet" href={u('/fonts/fonts.css')} />

    <title>{pageTitle}</title>

    <!-- 主题初始化:在首帧绘制前确定主题,避免闪烁 -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var def = document.documentElement.dataset.defaultTheme;
          var theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : def === 'light' || def === 'dark'
                ? def
                : window.matchMedia('(prefers-color-scheme: dark)').matches
                  ? 'dark'
                  : 'light';
          document.documentElement.dataset.theme = theme;
        } catch (e) {
          document.documentElement.dataset.theme = 'light';
        }
        // 打字机:JS 可用且非减少动态时,待打文本首绘即隐藏(见 global.css)
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.dataset.typewriter = 'on';
        }
      })();
    </script>

    <ClientRouter />

    <!-- View Transitions 软导航时,把当前主题带到新文档,防止换回亮色 -->
    <script>
      import { initImgReveal } from '../scripts/img-reveal';
      import { initCodeCopy } from '../scripts/code-copy';
      document.addEventListener('astro:page-load', () => {
        initImgReveal();
        initCodeCopy();
      });

      // 记录导航方向与是否涉及首页(首页的标题用淡入淡出,不做滚换)
      document.addEventListener('astro:before-preparation', (e) => {
        const ev = e as unknown as { direction?: string; from?: URL; to?: URL };
        const html = document.documentElement;
        html.dataset.navDir = ev.direction === 'back' ? 'back' : 'forward';
        const isHome = (u?: URL) => !!u && (u.pathname === '/' || u.pathname === '');
        html.dataset.softFade = isHome(ev.from) || isHome(ev.to) ? 'true' : 'false';
      });

      document.addEventListener('astro:before-swap', (e) => {
        const from = document.documentElement;
        const to = (e as unknown as { newDocument: Document }).newDocument.documentElement;
        // html 属性会被新文档整体替换,需要带过去的状态都在这里复制
        for (const key of ['theme', 'navDir', 'softFade', 'typewriter'] as const) {
          const value = from.dataset[key];
          if (value) to.dataset[key] = value;
        }
      });
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到正文</a>
    <FloatingCenteredHeader />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
    {/* 搜索模态与导航平级:模糊才罩得住整页,事件也不经导航冒泡 */}
    <SearchOverlay />
  </body>
</html>
