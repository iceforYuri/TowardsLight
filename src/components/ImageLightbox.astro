---
/**
 * 正文图片灯箱:点击 .prose 内的图片放大查看。
 * 无依赖;ESC / 点击任意处关闭;打开时锁定页面滚动,关闭后焦点归还。
 */
---

<div class="lightbox" data-lightbox hidden role="dialog" aria-modal="true" aria-label="放大查看图片">
  <figure class="lightbox-figure">
    <img data-lightbox-img alt="" decoding="async" />
    <figcaption class="lightbox-caption font-mono" data-lightbox-caption></figcaption>
  </figure>
</div>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(16px, 5vw, 64px);
    background: rgba(12, 14, 11, 0.74);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    cursor: zoom-out;
    opacity: 0;
    transition: opacity 0.24s ease;
  }

  /* display:flex 会压过 [hidden] 的 UA 样式,必须显式补回;
     否则灯箱透明常驻,拦截全页点击且 close() 因 hidden=true 提前返回 */
  .lightbox[hidden] {
    display: none;
  }

  .lightbox.open {
    opacity: 1;
  }

  .lightbox-figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    max-width: 100%;
    max-height: 100%;
    transform: scale(0.96);
    transition: transform 0.24s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .lightbox.open .lightbox-figure {
    transform: scale(1);
  }

  .lightbox-figure img {
    max-width: 100%;
    max-height: calc(100vh - 120px);
    object-fit: contain;
    border-radius: var(--radius-md);
    box-shadow: 0 32px 96px rgba(0, 0, 0, 0.42);
  }

  .lightbox-caption {
    font-size: var(--text-xs);
    font-weight: var(--weight-label);
    color: rgba(236, 237, 229, 0.75);
  }

  .lightbox-caption:empty {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .lightbox,
    .lightbox-figure {
      transition: none;
    }
  }
</style>

<script>
  function initLightbox() {
    const box = document.querySelector<HTMLElement>('[data-lightbox]');
    const img = box?.querySelector<HTMLImageElement>('[data-lightbox-img]');
    const cap = box?.querySelector<HTMLElement>('[data-lightbox-caption]');
    if (!box || !img || !cap) return;
    if (box.dataset.bound === '1') return;
    box.dataset.bound = '1';

    let lastFocus: Element | null = null;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function open(src: string, alt: string) {
      lastFocus = document.activeElement;
      img!.src = src;
      img!.alt = alt;
      cap!.textContent = alt;
      box!.hidden = false;
      requestAnimationFrame(() => box!.classList.add('open'));
      document.documentElement.style.overflow = 'hidden';
    }

    function close() {
      if (box!.hidden) return;
      box!.classList.remove('open');
      document.documentElement.style.overflow = '';
      const done = () => {
        box!.hidden = true;
        img!.src = '';
      };
      if (reduceMotion) done();
      else window.setTimeout(done, 240);
      if (lastFocus instanceof HTMLElement) lastFocus.focus();
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
    box.addEventListener('click', close);

    // 正文图片:可点击、可键盘触发;data-zoom-bound 防视图转场后重复绑定
    document
      .querySelectorAll<HTMLImageElement>('.prose img:not([data-zoom-bound])')
      .forEach((el) => {
        el.dataset.zoomBound = '1';
        el.setAttribute('tabindex', '0');
        el.setAttribute('role', 'button');
        el.setAttribute('aria-label', `放大查看图片${el.alt ? `:${el.alt}` : ''}`);
        // 加载失败的图(naturalWidth 为 0)不放大,避免灯箱里只剩 alt 文本
        const tryOpen = () => {
          if (el.complete && el.naturalWidth === 0) return;
          open(el.currentSrc || el.src, el.alt ?? '');
        };
        el.addEventListener('click', tryOpen);
        el.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            tryOpen();
          }
        });
      });

    document.addEventListener('astro:before-swap', close);
  }

  document.addEventListener('astro:page-load', initLightbox);
</script>
