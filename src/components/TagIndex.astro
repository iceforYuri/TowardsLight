---
/**
 * 标签索引:支持 索引(网格) / 列表 两种视图切换
 * - 热度分档:heat = 0.5·√(count/max) + 0.5·排名归一，连续自适应;
 *   只作用于图标颜色与边框浓度(背景不动),由 --heat 派生两个 mix 百分比
 * - 冒泡入场:延迟按标签名哈希固定(0~600ms),构建时注入，配置零负担
 */
import Icon from './Icon.astro';

interface Props {
  tags: [string, number][];
}

const { tags } = Astro.props;

const max = Math.max(1, ...tags.map(([, c]) => c));
const distinct = [...new Set(tags.map(([, c]) => c))].sort((a, b) => a - b);

const heatOf = (count: number) => {
  const sqrtPart = Math.sqrt(count / max);
  const rankPart = distinct.length > 1 ? distinct.indexOf(count) / (distinct.length - 1) : 1;
  return 0.5 * sqrtPart + 0.5 * rankPart;
};

/** 标签名 → 固定伪随机延迟，同一标签每次访问在同一时刻冒泡 */
const popDelay = (name: string) => {
  let h = 0;
  for (let i = 0; i < name.length; i++) h = (h * 31 + name.charCodeAt(i)) >>> 0;
  return h % 600;
};
---

<div class="tag-index" data-tag-index>
  <div class="index-toolbar">
    <span class="toolbar-hint font-mono">{tags.length} 个标签</span>
    <div class="view-toggle" role="group" aria-label="切换浏览方式">
      <button
        type="button"
        class="view-btn is-active"
        data-view="grid"
        aria-pressed="true"
        aria-label="索引视图"
        title="索引视图"
      >
        <Icon name="grid" size={15} />
      </button>
      <button
        type="button"
        class="view-btn"
        data-view="list"
        aria-pressed="false"
        aria-label="列表视图"
        title="列表视图"
      >
        <Icon name="list" size={15} />
      </button>
    </div>
  </div>

  <ul class="tag-cloud view-grid" data-tag-cloud>
    {
      tags.map(([tag, count]) => {
        const heat = heatOf(count);
        const iconMix = Math.round(35 + heat * 65);
        const borderMix = Math.round(heat * 40);
        return (
          <li>
            <a
              href={`/tags/${encodeURIComponent(tag)}`}
              class="tag-chip"
              style={`--icon-mix: ${iconMix}%; --border-mix: ${borderMix}%; --pop-delay: ${popDelay(tag)}ms`}
            >
              <Icon name="tag" size={13} class="chip-tag-icon" />
              <span class="tag-name">{tag}</span>
              <span class="tag-count font-mono">{count}</span>
            </a>
          </li>
        );
      })
    }
  </ul>
</div>

<style>
  .index-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
  }

  .toolbar-hint {
    font-size: 12.5px;
    color: var(--color-muted);
  }

  .view-toggle {
    display: inline-flex;
    gap: 2px;
    padding: 3px;
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: 999px;
  }

  .view-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 28px;
    border-radius: 999px;
    color: var(--color-muted);
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }

  .view-btn:hover {
    color: var(--color-text);
  }

  .view-btn.is-active {
    color: var(--color-accent-text);
    background: var(--color-surface);
    box-shadow: var(--shadow-raised);
  }

  .tag-cloud {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .tag-chip {
    display: inline-flex;
    align-items: baseline;
    gap: 7px;
    padding: 8px 15px;
    background: var(--color-surface-raised);
    /* 热度越高边框越偏 accent */
    border: 1px solid
      color-mix(in oklab, var(--color-accent) var(--border-mix, 0%), var(--color-border));
    border-radius: 999px;
    color: var(--color-text);
    font-family: var(--font-ui);
    font-size: 14px;
    max-width: 100%;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease,
      transform 0.2s ease;
  }

  .tag-chip:hover {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
    transform: translateY(-1px);
  }

  /* 小标签图标:热度越高越接近 accent 实色，冷标签退回 muted */
  .tag-chip :global(.chip-tag-icon) {
    color: color-mix(
      in oklab,
      var(--color-accent-text) var(--icon-mix, 35%),
      var(--color-muted)
    );
    flex-shrink: 0;
    align-self: center;
  }

  .tag-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 260px;
  }

  .tag-count {
    font-size: 11px;
    color: var(--color-muted);
  }

  /* 冒泡入场:JS+动效允许时先隐藏，转场结束后由 .ready 触发，
     每个 chip 按 --pop-delay(标签名哈希)在不同时刻弹现 */
  :global(html[data-typewriter='on']) .tag-cloud.view-grid .tag-chip {
    opacity: 0;
  }

  :global(html[data-typewriter='on']) [data-tag-index].ready .tag-cloud.view-grid .tag-chip {
    opacity: 1;
    animation: chip-pop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
    animation-delay: var(--pop-delay, 0ms);
  }

  @keyframes chip-pop {
    from {
      opacity: 0;
      transform: scale(0.5) translateY(6px);
    }
  }

  /* 列表视图 */
  .tag-cloud.view-list {
    flex-direction: column;
    gap: 0;
  }

  .tag-cloud.view-list .tag-chip {
    width: 100%;
    justify-content: space-between;
    border-radius: 0;
    border: none;
    border-bottom: 1px solid var(--color-border);
    background: none;
    padding: 13px 6px;
  }

  .tag-cloud.view-list .tag-chip:hover {
    background: var(--color-surface-raised);
    transform: none;
  }
</style>

<script>
  import { countUp } from '../scripts/typewriter';

  function initTagIndex() {
    document.querySelectorAll<HTMLElement>('[data-tag-index]').forEach((root) => {
      // 转场结束后触发冒泡入场
      root.classList.add('ready');

      const cloud = root.querySelector('[data-tag-cloud]');
      root.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const view = btn.dataset.view!;
          root.querySelectorAll('[data-view]').forEach((b) => {
            b.classList.toggle('is-active', b === btn);
            b.setAttribute('aria-pressed', String(b === btn));
          });
          cloud?.classList.toggle('view-grid', view === 'grid');
          cloud?.classList.toggle('view-list', view === 'list');
        });
      });

      // hover / 聚焦时篇数从 0 翻滚到真实值
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduced) return;
      root.querySelectorAll<HTMLElement>('.tag-chip').forEach((chip) => {
        const countEl = chip.querySelector<HTMLElement>('.tag-count');
        if (!countEl) return;
        const target = Number(countEl.textContent) || 0;
        let rolling = false;
        const roll = () => {
          if (rolling) return;
          rolling = true;
          countUp(countEl, target, 0, 350);
          window.setTimeout(() => (rolling = false), 380);
        };
        chip.addEventListener('mouseenter', roll);
        chip.addEventListener('focusin', roll);
      });
    });
  }
  document.addEventListener('astro:page-load', initTagIndex);
</script>
