---
interface Props {
  overlap?: 'hero' | 'stage' | 'none';
  class?: string;
}

const { overlap = 'hero', class: className = '' } = Astro.props;
---

<div class:list={['main-card', `overlap-${overlap}`, className]} transition:name="main-card">
  <slot />
</div>

<style>
  .main-card {
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: var(--shell-max);
    margin-inline: auto;
    background-color: var(--color-card);
    border-radius: var(--radius-lg);
    /* 描边并入阴影的 1px 环,边缘随阴影一起有深浅,不再是一根灰线 */
    box-shadow: var(--shadow-main-card);
    padding: clamp(24px, 5vw, 56px);
    /* 阅读面不做 hover 抬起:整篇正文随鼠标晃动会干扰阅读 */
    transition:
      box-shadow 0.3s ease,
      background-color 0.35s ease;
  }

  /* 暗色:顶部 320px 内极淡的受光渐变,卡面不再是一块平涂 */
  :global(html[data-theme='dark']) .main-card {
    background-image: linear-gradient(180deg, rgb(255 255 255 / 0.025), transparent 320px);
  }

  /* 与上方视觉区的重叠关系 */
  .overlap-hero {
    margin-top: clamp(-96px, -6vw, -48px);
  }

  .overlap-stage {
    margin-top: clamp(-72px, -5vw, -40px);
  }

  .overlap-none {
    margin-top: 40px;
  }

  @media (max-width: 640px) {
    .main-card {
      border-radius: 20px;
      padding: clamp(20px, 5vw, 28px);
    }

    .overlap-hero,
    .overlap-stage {
      margin-top: -28px;
    }
  }
</style>
