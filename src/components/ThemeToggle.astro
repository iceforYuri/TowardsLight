---
import Icon from './Icon.astro';
---

<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  data-dock-item
  data-tip="切换主题"
  aria-label="切换明暗主题"
  title="切换明暗主题"
>
  <span class="dock-bubble" aria-hidden="true" />
  <span class="icon-sun"><Icon name="sun" size={17} /></span>
  <span class="icon-moon"><Icon name="moon" size={17} /></span>
</button>

<style>
  .theme-toggle {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    margin-top: 0;
    border-radius: 50%;
    color: var(--color-muted);
    border: 1px solid transparent;
    /* 与 Dock 圆钮同一规格:真尺寸 + 泡泡光影 + 浮起投影 */
    box-shadow:
      0 calc(var(--grow, 0) * 10px) calc(var(--grow, 0) * 24px)
        rgba(20, 25, 20, calc(var(--grow, 0) * 0.2)),
      inset 0 0 0 1px rgb(var(--dock-ring) / calc(var(--grow, 0) * 0.9));
    transition:
      width 0.24s cubic-bezier(0.34, 1.56, 0.64, 1),
      height 0.24s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.18s ease,
      color 0.2s ease,
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  .theme-toggle:hover {
    color: var(--color-text);
    background: var(--color-accent-soft);
  }

  .icon-sun,
  .icon-moon {
    position: relative;
    z-index: 1;
    display: inline-flex;
    transform: scale(calc(1 + var(--grow, 0) * 0.45));
    transition: transform 0.35s ease;
  }

  :global(html[data-theme='light']) .icon-moon,
  :global(html[data-theme='dark']) .icon-sun {
    display: none;
  }

  .theme-toggle:hover .icon-sun {
    transform: scale(calc(1 + var(--grow, 0) * 0.45)) rotate(30deg);
  }

  .theme-toggle:hover .icon-moon {
    transform: scale(calc(1 + var(--grow, 0) * 0.45)) rotate(-15deg);
  }
</style>
