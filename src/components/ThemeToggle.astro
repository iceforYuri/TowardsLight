---
import Icon from './Icon.astro';
---

<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  aria-label="切换明暗主题"
  title="切换明暗主题"
>
  <span class="icon-sun"><Icon name="sun" size={17} /></span>
  <span class="icon-moon"><Icon name="moon" size={17} /></span>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    color: var(--color-muted);
    border: 1px solid transparent;
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  .theme-toggle:hover {
    color: var(--color-text);
    background: var(--color-accent-soft);
  }

  .icon-sun,
  .icon-moon {
    display: inline-flex;
    transition: transform 0.35s ease;
  }

  :global(html[data-theme='light']) .icon-moon,
  :global(html[data-theme='dark']) .icon-sun {
    display: none;
  }

  .theme-toggle:hover .icon-sun {
    transform: rotate(30deg);
  }

  .theme-toggle:hover .icon-moon {
    transform: rotate(-15deg);
  }
</style>
