---
import { site } from '../data/site';
import CurrentStatus from './CurrentStatus.astro';

const hero = site.homeHero;
// 打字机文本:去掉行尾句号，由闪烁的下划线光标接替终止符
const stripEnd = (s: string) => s.replace(/。\s*$/, '');
const tagline = stripEnd(hero.tagline);
const intro = stripEnd(hero.intro);
---

{/*
  v2 规格(docs/specs/2026-10-03-home-wallpaper-hero.md):
  - 壁纸层在 index.astro 的 .home-flow 直属(sticky 冻结的容器必须覆盖
    冻结行程 + 一屏,hero 不够高);此处只排身份组与文字色;
  - 身份组(.hero-group)sticky:上滚随文档下移,中心钳制在视口正中,钉住段发光;
  - hero 高度由首页锁底脚本给定(卡片顶缘恒等于一屏),min-height: 100svh 是无 JS 兜底。
*/}
<section class="hero">
  <div class="hero-content shell-container">
    <div class="hero-group">
      <div class="hero-status">
        <CurrentStatus />
      </div>
      <h1 class="hero-title font-display" transition:name="page-title">{hero.greeting}</h1>
      <div class="hero-body" transition:name="hero-body">
        <p class="hero-tagline" data-typewriter data-caret="fade">
          <span data-typewriter-text>{tagline}</span><span
            class="type-caret"
            data-typewriter-caret
            aria-hidden="true">_</span>
        </p>
        <p class="hero-intro" data-typewriter>
          <span data-typewriter-text>{intro}</span><span
            class="type-caret"
            data-typewriter-caret
            aria-hidden="true">_</span>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    /* 无 JS 兜底:接近一屏;有 JS 时锁底脚本给定精确高度 */
    min-height: 100svh;
    /* 文字色变量:默认取主题色,壁纸揭示后由下方 :global 规则覆盖 */
    --hero-fg: var(--color-text);
    --hero-fg-2: var(--color-accent-text);
    --hero-fg-m: var(--color-muted);
  }

  /* 图上文字模式:壁纸层在 .home-flow 直属,揭示后(.is-loaded)切换文字色。
     亮色主题按模式走,深色主题一律收暗配浅字。
     必须等壁纸真正揭示:图未到位时底下是主题画布色,
     图上浅字落在亮底上会隐形,看起来像"标题等图片淡入才显示" */
  :global(.home-flow[data-img-mode='on-dark']:has(.hero-backdrop.is-loaded)) .hero {
    --hero-fg: #f2f3ec;
    --hero-fg-2: color-mix(in oklab, var(--color-accent) 50%, #ffffff);
    --hero-fg-m: rgba(242, 243, 236, 0.74);
  }

  :global(.home-flow[data-img-mode='on-light']:has(.hero-backdrop.is-loaded)) .hero {
    --hero-fg: #1b1d1a;
    --hero-fg-2: color-mix(in oklab, var(--color-accent-text) 78%, #1b1d1a);
    --hero-fg-m: rgba(27, 29, 26, 0.74);
  }

  :global(html[data-theme='dark'] .home-flow[data-img-mode]:has(.hero-backdrop.is-loaded)) .hero {
    --hero-fg: #f2f3ec;
    --hero-fg-2: color-mix(in oklab, var(--color-accent) 50%, #ffffff);
    --hero-fg-m: rgba(242, 243, 236, 0.74);
  }

  /* 图到位/隐藏时,文字色随底色平滑过渡 */
  .hero-title,
  .hero-tagline,
  .hero-intro {
    transition: color 0.3s ease;
  }

  /* 身份组的 sticky 容器:撑满 hero 高度。padding 上多下少:
     让组的自然位置对准 S0 可见区(导航底~卡片顶)的光学中心;
     锁底脚本会按实测 L 重写 padding-top */
  .hero-content {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: calc(var(--nav-height) + 56px) 0 0;
  }

  /* 上滚编排:bottom 钳制使组中心不超过视口正中(50svh);
     下滚阅读时自然位置在钳制线之上,自由离场。--gh 由 JS 测量写入 */
  .hero-group {
    position: sticky;
    bottom: calc(50svh - var(--gh, 260px) / 2);
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: --glow 0.25s ease-out;
  }

  /* 发光:钉住段内 --glow 0→1(全局注册的可过渡属性,见 global.css);
     标题提亮并向主题色靠拢,泛起主题色微光晕;tagline/intro 半量 */
  .hero-title {
    font-size: clamp(48px, 9vw, 92px);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: 0.04em;
    color: color-mix(in oklab, var(--hero-fg), var(--hero-fg-2) calc(var(--glow, 0) * 28%));
    text-shadow: 0 0 calc(var(--glow, 0) * 26px)
      color-mix(in oklab, var(--hero-fg-2), transparent calc((1 - var(--glow, 0)) * 100%));
  }

  .hero-tagline,
  .hero-intro {
    text-shadow: 0 0 calc(var(--glow, 0) * 14px)
      color-mix(in oklab, var(--hero-fg-2), transparent calc((1 - var(--glow, 0)) * 100%));
  }

  .hero-body {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-status {
    margin-bottom: 28px;
  }

  .hero-tagline {
    margin-top: 18px;
    font-family: var(--font-display);
    font-size: clamp(17px, 2.4vw, 21px);
    font-weight: 600;
    color: var(--hero-fg-2);
    letter-spacing: 0.06em;
  }

  .hero-intro {
    margin-top: 22px;
    max-width: 520px;
    font-size: 15.5px;
    line-height: 1.9;
    color: var(--hero-fg-m);
  }

  /* 光标基础样式在 global.css(统计行在 hero 外也用);hero 内只定颜色 */
  .hero .type-caret {
    color: var(--hero-fg-2);
  }

  /* 移动端(≤640px):锁底与进入偏移由首页脚本停用,hero 退回自然流——
     满屏壁纸入场(高度不足一屏,让卡片顶缘在视口底探头作为内容提示),
     身份组近似居中;sticky/发光编排不受影响 */
  @media (max-width: 640px) {
    .hero {
      min-height: calc(100svh - 56px);
    }

    .hero-content {
      padding-top: calc(var(--nav-height) + 24px);
    }
  }
</style>

<script>
  /**
   * Hero 入场打字序列:tagline → 介绍 → 统计行(数字翻动)。
   * astro:page-load 在转场结束后触发，打字不会与转场快照打架。
   * SSR 已输出全文，减少动态偏好时全部保持静态。
   */
  import { runTypewriter } from '../scripts/typewriter';

  let ctrl: AbortController | undefined;

  const sleep = (ms: number, signal?: AbortSignal) =>
    new Promise<void>((resolve) => {
      if (signal?.aborted) return resolve();
      const t = window.setTimeout(resolve, ms);
      signal?.addEventListener(
        'abort',
        () => {
          window.clearTimeout(t);
          resolve();
        },
        { once: true },
      );
    });

  async function runHeroSequence(signal: AbortSignal) {
    const taglineEl = document.querySelector<HTMLElement>('.hero-tagline[data-typewriter]');
    const introEl = document.querySelector<HTMLElement>('.hero-intro[data-typewriter]');
    const statsEl = document.querySelector<HTMLElement>('.hero-stats[data-typewriter]');
    if (!taglineEl && !introEl && !statsEl) return;

    // 多行同时打印，各自按自己的速度走完。
    // 注意:astro:page-load 触发于转场开始(updateCallbackDone),
    // 延迟 460ms 等转场播完再开打,避免开头几个字被快照盖住
    await sleep(460, signal);
    if (signal.aborted) return;
    await Promise.all([
      taglineEl ? runTypewriter(taglineEl, { charDelay: 60, signal }) : null,
      introEl ? runTypewriter(introEl, { charDelay: 48, signal }) : null,
      statsEl ? runTypewriter(statsEl, { charDelay: 42, signal }) : null,
    ]);
  }

  function initHeroTyping() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    ctrl?.abort();
    ctrl = new AbortController();
    runHeroSequence(ctrl.signal);
  }

  document.addEventListener('astro:page-load', initHeroTyping);
  document.addEventListener('astro:before-swap', () => ctrl?.abort());

  /**
   * 身份组发光编排(v2 规格):
   * 上滚时组随文档下移,中心触及视口正中后被 sticky 钳住;
   * 钳住段内 --glow 从 0 升到 1。
   * 钳制生效点 stickStart = 组自然文档中心 − 视口半高;
   * 组高写入 --gh 供 sticky 的 bottom 钳制线使用。
   * 壁纸冻结是纯 CSS sticky(见 index.astro),不经过本脚本。
   * 减少动态偏好:整套不启用(--glow 恒 0,无阴影,sticky 位置行为保留)。
   */
  let stickStart = 0;
  let glowRaf = 0;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  function measureGlow() {
    const hero = document.querySelector<HTMLElement>('.hero');
    const group = document.querySelector<HTMLElement>('.hero-group');
    if (!hero || !group) return;
    const gh = group.offsetHeight;
    hero.style.setProperty('--gh', `${Math.round(gh)}px`);
    // offsetTop 沿定位祖先累加到文档顶;sticky 不影响 offsetTop(恒为自然位置)
    let docTop = 0;
    let el: HTMLElement | null = group;
    while (el) {
      docTop += el.offsetTop;
      el = el.offsetParent as HTMLElement | null;
    }
    stickStart = Math.max(1, docTop + gh / 2 - window.innerHeight / 2);
  }

  function updateGlow() {
    glowRaf = 0;
    const hero = document.querySelector<HTMLElement>('.hero');
    if (!hero) return;
    const p = Math.min(1, Math.max(0, (stickStart - window.scrollY) / stickStart));
    hero.style.setProperty('--glow', p.toFixed(3));
  }

  function onGlowScroll() {
    if (!glowRaf) glowRaf = requestAnimationFrame(updateGlow);
  }

  if (!reduceMotion.matches) {
    window.addEventListener('scroll', onGlowScroll, { passive: true });
    window.addEventListener('resize', () => measureGlow());
    document.addEventListener('astro:page-load', () => {
      measureGlow();
      updateGlow();
    });
    // 锁底脚本会重排身份组(自适应 padding),锁完必须重测
    document.addEventListener('hero:locked', () => measureGlow());
    // 字体落盘后组高/位置可能变化,重测(锁底脚本同样监听,同帧内先后无碍)
    document.fonts?.ready.then(() => requestAnimationFrame(measureGlow));
  }
</script>
