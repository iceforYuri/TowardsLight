---
import { site } from '../data/site';
import CurrentStatus from './CurrentStatus.astro';

type StatSegment = { t: 'text'; v: string } | { t: 'num'; v: number; d?: number };

interface Props {
  /**
   * 统计行分段:文本逐字打出,数字段(num)在光标经过时翻动计数。
   * 构建时从内容集合算出;d 为小数位数(如 8.4 万字)。
   */
  statsSegments: StatSegment[];
}

const { statsSegments } = Astro.props;
const hero = site.homeHero;
// 打字机文本:去掉行尾句号,由闪烁的下划线光标接替终止符
const stripEnd = (s: string) => s.replace(/。\s*$/, '');
const tagline = stripEnd(hero.tagline);
const intro = stripEnd(hero.intro);
---

<section class="hero">
  {
    hero.background && (
      <div class="hero-backdrop" aria-hidden="true" transition:name="stage-media">
        <img
          src={hero.background}
          alt=""
          class="hero-img img-reveal"
          loading="eager"
          fetchpriority="high"
          onload="this.classList.add('is-loaded')"
          onerror="this.closest('.hero-backdrop').remove()"
        />
        <div class="hero-scrim" />
      </div>
    )
  }

  <div class="hero-content shell-container">
    <div class="hero-status">
      <CurrentStatus />
    </div>
    <h1 class="hero-title font-display" transition:name="page-title">{hero.greeting}</h1>
    <div class="hero-body" transition:name="hero-body">
      <p class="hero-tagline" data-typewriter data-caret="fade">
        <span data-typewriter-text>{tagline}</span><span
          class="type-caret"
          data-typewriter-caret
          aria-hidden="true">_</span>
      </p>
      <p class="hero-intro" data-typewriter>
        <span data-typewriter-text>{intro}</span><span
          class="type-caret"
          data-typewriter-caret
          aria-hidden="true">_</span>
      </p>
      <p class="hero-meta font-mono" data-typewriter>
        <span data-typewriter-text>{
          statsSegments.map((seg) =>
            seg.t === 'num' ? (
              <span class="type-num" data-count-to={seg.v} data-decimals={seg.d ?? 0}>{seg.d ? seg.v.toFixed(seg.d) : seg.v}</span>
            ) : (
              <>{seg.v}</>
            ),
          )
        }</span><span class="type-caret" data-typewriter-caret aria-hidden="true">_</span>
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 72svh;
    padding-top: calc(var(--nav-height) + 72px);
    padding-bottom: 112px;
    overflow: hidden;
  }

  .hero-backdrop {
    position: absolute;
    inset: 0;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      var(--color-overlay) 0%,
      transparent 28%,
      transparent 68%,
      var(--color-canvas) 96%
    );
  }

  /* 深色主题:整幅再压一层,保证标题区对比度 */
  :global(html[data-theme='dark']) .hero-scrim {
    background: linear-gradient(
      to bottom,
      var(--color-overlay) 0%,
      rgba(23, 25, 22, 0.42) 40%,
      rgba(23, 25, 22, 0.55) 70%,
      var(--color-canvas) 97%
    );
  }

  .hero-content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-body {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-status {
    margin-bottom: 28px;
  }

  .hero-title {
    font-size: clamp(44px, 8vw, 76px);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: 0.02em;
    color: var(--color-text);
  }

  .hero-tagline {
    margin-top: 18px;
    font-family: var(--font-display);
    font-size: clamp(17px, 2.4vw, 21px);
    font-weight: 600;
    color: var(--color-accent-text);
    letter-spacing: 0.06em;
  }

  .hero-intro {
    margin-top: 22px;
    max-width: 520px;
    font-size: 15.5px;
    line-height: 1.9;
    color: var(--color-muted);
  }

  .hero-meta {
    margin-top: 30px;
    font-size: 12.5px;
    letter-spacing: 0.03em;
    line-height: 1.8;
    text-align: center;
    color: var(--color-muted);
  }

  .type-num {
    color: var(--color-accent-text);
  }

  /* 下划线光标:打字中跟随,打完代替句号常亮闪烁。
     动画从首帧就挂在元素上(visibility 隐藏也走时钟),多处光标闪烁同步 */
  .type-caret {
    visibility: hidden;
    margin-left: 1px;
    font-family: var(--font-mono);
    color: var(--color-accent);
    animation: caret-blink 0.85s steps(1) infinite;
  }

  [data-typewriter][data-typing='true'] .type-caret,
  [data-typewriter][data-done='true'] .type-caret {
    visibility: visible;
  }

  /* 标题行的光标只是打字指示,打完即淡出;句子行的光标代替句号常驻 */
  [data-typewriter][data-caret='fade'][data-done='true'] .type-caret {
    animation: none;
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  @keyframes caret-blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }

  @media (max-width: 640px) {
    .hero {
      min-height: auto;
      padding-bottom: 100px;
    }
  }
</style>

<script>
  /**
   * Hero 入场打字序列:tagline → 介绍 → 统计行(数字翻动)。
   * astro:page-load 在转场结束后触发,打字不会与转场快照打架。
   * SSR 已输出全文,减少动态偏好时全部保持静态。
   */
  import { runTypewriter } from '../scripts/typewriter';

  let ctrl: AbortController | undefined;

  const sleep = (ms: number, signal?: AbortSignal) =>
    new Promise<void>((resolve) => {
      if (signal?.aborted) return resolve();
      const t = window.setTimeout(resolve, ms);
      signal?.addEventListener(
        'abort',
        () => {
          window.clearTimeout(t);
          resolve();
        },
        { once: true },
      );
    });

  async function runHeroSequence(signal: AbortSignal) {
    const taglineEl = document.querySelector<HTMLElement>('.hero-tagline[data-typewriter]');
    const introEl = document.querySelector<HTMLElement>('.hero-intro[data-typewriter]');
    const statsEl = document.querySelector<HTMLElement>('.hero-meta[data-typewriter]');
    if (!taglineEl && !introEl && !statsEl) return;

    // 多行同时打印,各自按自己的速度走完
    await sleep(300, signal);
    if (signal.aborted) return;
    await Promise.all([
      taglineEl ? runTypewriter(taglineEl, { charDelay: 60, signal }) : null,
      introEl ? runTypewriter(introEl, { charDelay: 48, signal }) : null,
      statsEl ? runTypewriter(statsEl, { charDelay: 42, signal }) : null,
    ]);
  }

  function initHeroTyping() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    ctrl?.abort();
    ctrl = new AbortController();
    runHeroSequence(ctrl.signal);
  }

  document.addEventListener('astro:page-load', initHeroTyping);
  document.addEventListener('astro:before-swap', () => ctrl?.abort());
</script>
