---
import { site } from '../data/site';
import CurrentStatus from './CurrentStatus.astro';

interface Props {
  /** 一行式统计文案,构建时从内容集合算出;支持打字机效果,无 JS 时直接显示全文 */
  statsText: string;
}

const { statsText } = Astro.props;
const hero = site.homeHero;
---

<section class="hero">
  {
    hero.background && (
      <div class="hero-backdrop" aria-hidden="true" transition:name="stage-media">
        <img
          src={hero.background}
          alt=""
          class="hero-img img-reveal"
          loading="eager"
          fetchpriority="high"
          onload="this.classList.add('is-loaded')"
          onerror="this.closest('.hero-backdrop').remove()"
        />
        <div class="hero-scrim" />
      </div>
    )
  }

  <div class="hero-content shell-container">
    <div class="hero-status">
      <CurrentStatus />
    </div>
    <h1 class="hero-title font-display" transition:name="page-title">{hero.greeting}</h1>
    <div class="hero-body" transition:name="hero-body">
      <p class="hero-tagline">{hero.tagline}</p>
      <p class="hero-intro">{hero.intro}</p>
      <p class="hero-meta font-mono" data-typewriter>
        <span data-typewriter-text>{statsText}</span><span class="type-caret" aria-hidden="true"
        ></span>
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 72svh;
    padding-top: calc(var(--nav-height) + 72px);
    padding-bottom: 112px;
    overflow: hidden;
  }

  .hero-backdrop {
    position: absolute;
    inset: 0;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      var(--color-overlay) 0%,
      transparent 28%,
      transparent 68%,
      var(--color-canvas) 96%
    );
  }

  /* 深色主题:整幅再压一层,保证标题区对比度 */
  :global(html[data-theme='dark']) .hero-scrim {
    background: linear-gradient(
      to bottom,
      var(--color-overlay) 0%,
      rgba(23, 25, 22, 0.42) 40%,
      rgba(23, 25, 22, 0.55) 70%,
      var(--color-canvas) 97%
    );
  }

  .hero-content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-body {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-status {
    margin-bottom: 28px;
  }

  .hero-title {
    font-size: clamp(44px, 8vw, 76px);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: 0.02em;
    color: var(--color-text);
  }

  .hero-tagline {
    margin-top: 18px;
    font-family: var(--font-display);
    font-size: clamp(17px, 2.4vw, 21px);
    font-weight: 600;
    color: var(--color-accent-text);
    letter-spacing: 0.06em;
  }

  .hero-intro {
    margin-top: 22px;
    max-width: 520px;
    font-size: 15.5px;
    line-height: 1.9;
    color: var(--color-muted);
  }

  .hero-meta {
    margin-top: 30px;
    font-size: 12.5px;
    letter-spacing: 0.03em;
    line-height: 1.8;
    text-align: center;
    color: var(--color-muted);
  }

  .type-caret {
    display: none;
  }

  /* 打字中 / 刚打完:显示光标;打完后淡出 */
  .hero-meta[data-typing='true'] .type-caret,
  .hero-meta[data-done='true'] .type-caret {
    display: inline-block;
    width: 2px;
    height: 1.05em;
    margin-left: 3px;
    vertical-align: -0.15em;
    background: var(--color-accent);
  }

  .hero-meta[data-typing='true'] .type-caret {
    animation: caret-blink 0.85s steps(1) infinite;
  }

  .hero-meta[data-done='true'] .type-caret {
    animation: none;
    opacity: 0;
    transition: opacity 0.7s ease;
  }

  @keyframes caret-blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }

  @media (max-width: 640px) {
    .hero {
      min-height: auto;
      padding-bottom: 100px;
    }
  }
</style>

<script>
  /**
   * Hero 统计行打字机:只打一遍,打完光标淡出。
   * SSR 已输出全文,减少动态偏好或无 JS 时直接保持全文显示。
   */
  function initTypewriter() {
    document.querySelectorAll<HTMLElement>('[data-typewriter]').forEach((el) => {
      const span = el.querySelector<HTMLElement>('[data-typewriter-text]');
      if (!span) return;
      const text = span.textContent ?? '';
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduced || !text) return;

      // 先量出全文宽度并固定,打字时文字从稳定的左缘生长,整行不晃动
      const fullWidth = span.offsetWidth;
      span.style.display = 'inline-block';
      span.style.minWidth = `${fullWidth}px`;
      span.style.maxWidth = '100%';
      span.style.textAlign = 'left';
      span.textContent = '';
      el.dataset.typing = 'true';

      let i = 0;
      let timer: number | undefined;
      const tick = () => {
        i += 1;
        span.textContent = text.slice(0, i);
        if (i < text.length) {
          timer = window.setTimeout(tick, 34);
        } else {
          // 保留 typing 让光标继续显示,由 done 状态把它淡出
          el.dataset.done = 'true';
        }
      };
      timer = window.setTimeout(tick, 420);

      document.addEventListener('astro:before-swap', () => window.clearTimeout(timer), {
        once: true,
      });
    });
  }
  document.addEventListener('astro:page-load', initTypewriter);
</script>
