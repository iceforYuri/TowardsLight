---
import { site } from '../data/site';
import { u, stageMediaName } from '../utils/url';
import { resolveImgMode } from '../utils/image-luminance';
import CurrentStatus from './CurrentStatus.astro';

const hero = site.homeHero;
// 构建期采样背景图亮度:决定图上文字模式(on-dark 浅字 / on-light 深字)与遮罩强度
const { imgMode, imgScrim, imgScrimDark } = await resolveImgMode(hero.background, hero.textMode, 'hero');
// 打字机文本:去掉行尾句号，由闪烁的下划线光标接替终止符
const stripEnd = (s: string) => s.replace(/。\s*$/, '');
const tagline = stripEnd(hero.tagline);
const intro = stripEnd(hero.intro);
---

{/*
  v2 规格(docs/specs/2026-10-03-home-wallpaper-hero.md):
  - 壁纸层铺满 hero、随内容滚动;hero 略高于一屏,图片按视口比例缩放不过度放大;
  - 身份组(.hero-group)sticky:上滚随文档下移,中心钳制在视口正中,钉住段发光;
  - hero 高度由首页锁底脚本给定(卡片顶缘恒等于一屏),min-height: 100svh 是无 JS 兜底。
*/}
<section class="hero" data-img-mode={imgMode} style={imgMode ? `--img-scrim: ${imgScrim}; --img-scrim-dark: ${imgScrimDark}` : undefined}>
  {
    hero.background && (
      <div class="hero-backdrop img-reveal" aria-hidden="true" transition:name={stageMediaName(hero.background)}>
        {/* 转场图层序:背景组始终压在卡片之下(转场名按图区分,见 utils/url) */}
        <style is:global set:html={`::view-transition-group(${stageMediaName(hero.background)}) { z-index: 1; }`} />
        <img
          src={u(hero.background)}
          alt=""
          class="hero-img"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          onerror="this.closest('.hero-backdrop').remove()"
        />
        <div class="hero-scrim" />
      </div>
    )
  }

  <div class="hero-content shell-container">
    <div class="hero-group">
      <div class="hero-status">
        <CurrentStatus />
      </div>
      <h1 class="hero-title font-display" transition:name="page-title">{hero.greeting}</h1>
      <div class="hero-body" transition:name="hero-body">
        <p class="hero-tagline" data-typewriter data-caret="fade">
          <span data-typewriter-text>{tagline}</span><span
            class="type-caret"
            data-typewriter-caret
            aria-hidden="true">_</span>
        </p>
        <p class="hero-intro" data-typewriter>
          <span data-typewriter-text>{intro}</span><span
            class="type-caret"
            data-typewriter-caret
            aria-hidden="true">_</span>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    /* 无 JS 兜底:接近一屏;有 JS 时锁底脚本给定精确高度 */
    min-height: 100svh;/* 文字色变量:默认取主题色,有背景图时由 data-img-mode 覆盖 */
    --hero-fg: var(--color-text);
    --hero-fg-2: var(--color-accent-text);
    --hero-fg-m: var(--color-muted);
  }

  /* 壁纸层:恰好一屏高(100svh),图片永按视口比例缩放。
     冻结:简介线之上的行程内由脚本补偿位移、钉住视口(满屏不动);
     简介线之下(阅读区)补偿停在 L,随文档一体滚动 */
  .hero-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 100svh;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* 顶部导航保护 + 文字区压暗;底部画布羽化已移交羽化幕布(.home-body) */
  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, var(--color-overlay) 0%, transparent 28%);
  }

  /* 深色主题兜底:仅在采样失败(无 data-img-mode)时上段再压一层 */
  :global(html[data-theme='dark']) .hero:not([data-img-mode]) .hero-scrim {
    background: linear-gradient(
      to bottom,
      var(--color-overlay) 0%,
      rgba(23, 25, 22, 0.42) 40%,
      rgba(23, 25, 22, 0.55) 70%
    );
  }


  /* 图上文字模式:构建期按图片亮度采样决定(见 utils/image-luminance);
     亮色主题按模式走,深色主题一律收暗配浅字;遮罩强度由 --img-scrim(--img-scrim-dark) 注入。
     仅在背景真正揭示后套用(:has .is-loaded):图未到位时底下是主题画布色,
     图上浅字落在亮底上会隐形,看起来像"标题等图片淡入才显示" */
  .hero[data-img-mode='on-dark']:has(.hero-backdrop.is-loaded) {
    --hero-fg: #f2f3ec;
    --hero-fg-2: color-mix(in oklab, var(--color-accent) 50%, #ffffff);
    --hero-fg-m: rgba(242, 243, 236, 0.74);
  }

  .hero[data-img-mode='on-light']:has(.hero-backdrop.is-loaded) {
    --hero-fg: #1b1d1a;
    --hero-fg-2: color-mix(in oklab, var(--color-accent-text) 78%, #1b1d1a);
    --hero-fg-m: rgba(27, 29, 26, 0.74);
  }

  .hero[data-img-mode='on-dark'] .hero-scrim {
    background: linear-gradient(
      to bottom,
      rgba(18, 20, 17, calc(var(--img-scrim, 0.35) * 0.7)) 0%,
      rgba(18, 20, 17, var(--img-scrim, 0.35)) 42%,
      rgba(18, 20, 17, calc(var(--img-scrim, 0.35) * 0.85)) 68%
    );
  }

  .hero[data-img-mode='on-light'] .hero-scrim {
    background: linear-gradient(
      to bottom,
      rgba(244, 245, 241, calc(var(--img-scrim, 0.35) * 0.55)) 0%,
      rgba(244, 245, 241, var(--img-scrim, 0.35)) 42%,
      rgba(244, 245, 241, calc(var(--img-scrim, 0.35) * 0.8)) 68%
    );
  }


  /* 深色主题:有图一律收暗 + 浅字(处理后亮度恒 <128;同样等背景揭示后套用) */
  :global(html[data-theme='dark']) .hero[data-img-mode]:has(.hero-backdrop.is-loaded) {
    --hero-fg: #f2f3ec;
    --hero-fg-2: color-mix(in oklab, var(--color-accent) 50%, #ffffff);
    --hero-fg-m: rgba(242, 243, 236, 0.74);
  }

  /* 图到位/隐藏时,文字色随底色平滑过渡 */
  .hero-title,
  .hero-tagline,
  .hero-intro {
    transition: color 0.3s ease;
  }

  :global(html[data-theme='dark']) .hero[data-img-mode] .hero-scrim {
    background: linear-gradient(
      to bottom,
      rgba(18, 20, 17, calc(var(--img-scrim-dark, 0.45) * 0.7)) 0%,
      rgba(18, 20, 17, var(--img-scrim-dark, 0.45)) 42%,
      rgba(18, 20, 17, calc(var(--img-scrim-dark, 0.45) * 0.85)) 68%
    );
  }

  /* 身份组的 sticky 容器:撑满 hero 高度。padding 上多下少:
     让组的自然位置对准 S0 可见区(导航底~卡片顶)的光学中心 */
  .hero-content {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: calc(var(--nav-height) + 56px) 0 0;
  }

  /* 上滚编排:bottom 钳制使组中心不超过视口正中(50svh);
     下滚阅读时自然位置在钳制线之上,自由离场。--gh 由 JS 测量写入 */
  .hero-group {
    position: sticky;
    bottom: calc(50svh - var(--gh, 260px) / 2);
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: --glow 0.25s ease-out;
  }

  /* 发光:钉住段内 --glow 0→1(全局注册的可过渡属性,见 global.css);
     标题提亮并向主题色靠拢,泛起主题色微光晕;tagline/intro 半量 */
  .hero-title {
    font-size: clamp(44px, 8vw, 76px);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: 0.02em;
    color: color-mix(in oklab, var(--hero-fg), var(--hero-fg-2) calc(var(--glow, 0) * 28%));
    text-shadow: 0 0 calc(var(--glow, 0) * 26px)
      color-mix(in oklab, var(--hero-fg-2), transparent calc((1 - var(--glow, 0)) * 100%));
  }

  .hero-tagline,
  .hero-intro {
    text-shadow: 0 0 calc(var(--glow, 0) * 14px)
      color-mix(in oklab, var(--hero-fg-2), transparent calc((1 - var(--glow, 0)) * 100%));
  }

  .hero-body {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-status {
    margin-bottom: 28px;
  }

  .hero-tagline {
    margin-top: 18px;
    font-family: var(--font-display);
    font-size: clamp(17px, 2.4vw, 21px);
    font-weight: 600;
    color: var(--hero-fg-2);
    letter-spacing: 0.06em;
  }

  .hero-intro {
    margin-top: 22px;
    max-width: 520px;
    font-size: 15.5px;
    line-height: 1.9;
    color: var(--hero-fg-m);
  }

  /* 光标基础样式在 global.css(统计行在 hero 外也用);hero 内只定颜色 */
  .hero .type-caret {
    color: var(--hero-fg-2);
  }

  /* 移动端(≤640px):锁底与进入偏移由首页脚本停用,hero 退回自然流——
     完整壁纸入场(高度不足一屏,让卡片顶缘在视口底探头作为内容提示),
     身份组近似居中;sticky/发光编排不受影响 */
  @media (max-width: 640px) {
    .hero {
      min-height: calc(100svh - 56px);
    }

    .hero-content {
      padding-top: calc(var(--nav-height) + 24px);
    }
  }
</style>

<script>
  /**
   * Hero 入场打字序列:tagline → 介绍 → 统计行(数字翻动)。
   * astro:page-load 在转场结束后触发，打字不会与转场快照打架。
   * SSR 已输出全文，减少动态偏好时全部保持静态。
   */
  import { runTypewriter } from '../scripts/typewriter';

  let ctrl: AbortController | undefined;

  const sleep = (ms: number, signal?: AbortSignal) =>
    new Promise<void>((resolve) => {
      if (signal?.aborted) return resolve();
      const t = window.setTimeout(resolve, ms);
      signal?.addEventListener(
        'abort',
        () => {
          window.clearTimeout(t);
          resolve();
        },
        { once: true },
      );
    });

  async function runHeroSequence(signal: AbortSignal) {
    const taglineEl = document.querySelector<HTMLElement>('.hero-tagline[data-typewriter]');
    const introEl = document.querySelector<HTMLElement>('.hero-intro[data-typewriter]');
    const statsEl = document.querySelector<HTMLElement>('.hero-stats[data-typewriter]');
    if (!taglineEl && !introEl && !statsEl) return;

    // 多行同时打印，各自按自己的速度走完。
    // 注意:astro:page-load 触发于转场开始(updateCallbackDone),
    // 延迟 460ms 等转场播完再开打,避免开头几个字被快照盖住
    await sleep(460, signal);
    if (signal.aborted) return;
    await Promise.all([
      taglineEl ? runTypewriter(taglineEl, { charDelay: 60, signal }) : null,
      introEl ? runTypewriter(introEl, { charDelay: 48, signal }) : null,
      statsEl ? runTypewriter(statsEl, { charDelay: 42, signal }) : null,
    ]);
  }

  function initHeroTyping() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    ctrl?.abort();
    ctrl = new AbortController();
    runHeroSequence(ctrl.signal);
  }

  document.addEventListener('astro:page-load', initHeroTyping);
  document.addEventListener('astro:before-swap', () => ctrl?.abort());

  /**
   * 身份组发光 + 壁纸冻结(v2 规格):
   * - 发光:上滚时组随文档下移,中心触及视口正中后被 sticky 钳住;
   *   钳住段内 --glow 从 0 升到 1。钳制生效点 stickStart = 组自然文档中心 − 视口半高;
   *   组高写入 --gh 供 sticky 的 bottom 钳制线使用。
   * - 冻结:壁纸层恰好一屏高,行程内(scrollY ∈ [0, L])补偿位移钉住视口,
   *   行程外停在 L 随文档滚动;L 从 --journey 读取(锁底脚本写入,未锁底为 0=不冻结)。
   * 两者共用同一 rAF 滚动回调。减少动态偏好:无发光,冻结保留(纯位置行为)。
   */
  let stickStart = 0;
  let journey = 0;
  let scrollRaf = 0;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  function measureGlow() {
    const hero = document.querySelector<HTMLElement>('.hero');
    const group = document.querySelector<HTMLElement>('.hero-group');
    if (!hero || !group) return;
    const gh = group.offsetHeight;
    hero.style.setProperty('--gh', `${Math.round(gh)}px`);
    // offsetTop 沿定位祖先累加到文档顶;sticky 不影响 offsetTop(恒为自然位置)
    let docTop = 0;
    let el: HTMLElement | null = group;
    while (el) {
      docTop += el.offsetTop;
      el = el.offsetParent as HTMLElement | null;
    }
    stickStart = Math.max(1, docTop + gh / 2 - window.innerHeight / 2);
  }

  function measureJourney() {
    journey =
      parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--journey')) || 0;
  }

  function updateFreeze() {
    const backdrop = document.querySelector<HTMLElement>('.hero-backdrop');
    if (!backdrop) return;
    const y = Math.max(0, Math.min(window.scrollY, journey));
    backdrop.style.transform = y > 0 ? `translateY(${y}px)` : '';
  }

  function updateGlow() {
    const hero = document.querySelector<HTMLElement>('.hero');
    if (!hero) return;
    const p = Math.min(1, Math.max(0, (stickStart - window.scrollY) / stickStart));
    hero.style.setProperty('--glow', p.toFixed(3));
  }

  function onScrollFrame() {
    if (scrollRaf) return;
    scrollRaf = requestAnimationFrame(() => {
      scrollRaf = 0;
      updateFreeze();
      if (!reduceMotion.matches) updateGlow();
    });
  }

  function measureAll() {
    measureJourney();
    updateFreeze();
    if (reduceMotion.matches) return;
    measureGlow();
    updateGlow();
  }

  window.addEventListener('scroll', onScrollFrame, { passive: true });
  window.addEventListener('resize', () => measureAll());
  // 锁底脚本会重排身份组并写入 --journey,锁完必须重测
  document.addEventListener('hero:locked', () => measureAll());
  document.addEventListener('astro:page-load', () => measureAll());
  // 字体落盘后组高/位置可能变化,重测(锁底脚本同样监听,同帧内先后无碍)
  document.fonts?.ready.then(() => requestAnimationFrame(measureAll));
  // 顶层立即执行一次:覆盖硬加载时锁底脚本尚未运行前的首帧
  measureAll();
</script>
