---
import Icon from './Icon.astro';
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  variant: 'mobile' | 'desktop';
}

const { headings, variant } = Astro.props;
// 正文 h1–h6 全进目录;按实际最小层级归一化——正文有 h1 时 h2 自动降一级,
// 没有 h1 时 h2 即顶级;视觉层级 lv-0(顶级)到 lv-5,递进缩进弱化
const toc = headings.filter((h) => h.depth >= 1 && h.depth <= 6);
const minDepth = Math.min(...toc.map((h) => h.depth));
const levelOf = (depth: number) => Math.min(depth - minDepth, 5);

// 桌面侧栏按族收放:lv-3~5(标注级)归属最近的 lv-0~2 祖先,默认折叠,
// 滚动进入该族时展开、离开即收;移动面板与抽屉始终完整展开
type TocItem = { h: (typeof toc)[number]; lv: number };
const groups: { head: TocItem; subs: TocItem[] }[] = [];
for (const h of toc) {
  const lv = levelOf(h.depth);
  if (lv <= 2 || groups.length === 0) groups.push({ head: { h, lv }, subs: [] });
  else groups[groups.length - 1].subs.push({ h, lv });
}
---

{
  toc.length > 0 && variant === 'mobile' && (
    <div class="toc-mobile">
      <button
        type="button"
        class="toc-toggle"
        data-toc-toggle
        aria-expanded="false"
        aria-controls="toc-panel"
      >
        <Icon name="list" size={15} />
        <span>本文目录</span>
        <Icon name="chevron-down" size={14} class="toc-chevron" />
      </button>
      <nav class="toc-panel" id="toc-panel" data-toc-panel hidden aria-label="文章目录">
        <ul>
          {toc.map((h) => (
            <li class={`lv-${levelOf(h.depth)}`}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  )
}

{
  toc.length > 0 && variant === 'desktop' && (
    <nav class="toc-desktop" aria-label="文章目录">
      <p class="toc-heading font-mono">CONTENTS</p>
      <ul>
        {groups.map((g) => (
          <>
            <li class={`lv-${g.head.lv}`}>
              <a href={`#${g.head.h.slug}`} data-toc-link={g.head.h.slug} title={g.head.h.text}>
                {g.head.h.text}
              </a>
            </li>
            {g.subs.length > 0 && (
              <li class="toc-subs" data-family={g.head.h.slug} inert aria-hidden="true">
                <div class="toc-subs-inner">
                  <ul>
                    {g.subs.map((s) => (
                      <li class={`lv-${s.lv}`}>
                        <a href={`#${s.h.slug}`} data-toc-link={s.h.slug} title={s.h.text}>
                          {s.h.text}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </li>
            )}
          </>
        ))}
      </ul>
      <p class="toc-percent font-mono" data-toc-percent aria-hidden="true" />
      <span class="toc-rail" aria-hidden="true">
        <span class="toc-rail-fill" data-toc-rail />
      </span>
    </nav>
  )
}

<style>
  .toc-desktop {
    position: sticky;
    top: 96px;
    max-height: calc(100svh - 140px);
    overflow-y: auto;
    padding-left: 18px;
    border-left: 1px solid var(--color-border);
  }

  .toc-heading {
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--color-muted);
    margin-bottom: 12px;
  }

  .toc-desktop ul,
  .toc-panel ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .toc-desktop a {
    position: relative;
    display: block;
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    transition: color 0.2s ease;
  }

  .toc-desktop a:hover {
    color: var(--color-text);
  }

  /* 当前小节:沿所在族色相加深 + 加粗 + 下划线,左侧指示条保留 */
  .toc-desktop a.is-current {
    color: var(--color-accent-text);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 3px;
  }

  .toc-desktop .lv-3 a.is-current,
  .toc-desktop .lv-4 a.is-current,
  .toc-desktop .lv-5 a.is-current {
    color: color-mix(in oklab, var(--color-contrast) 72%, var(--color-text));
    text-decoration-color: var(--color-contrast);
  }

  .toc-desktop a.is-current::before {
    content: '';
    position: absolute;
    left: -19px;
    top: 2px;
    bottom: 2px;
    width: 2px;
    border-radius: 2px;
    background: var(--color-accent);
  }

  /* 深层级族(lv-3~5):默认折叠,当前族展开(离开即收);
     margin 抵消 ul flex gap,折叠时不留空位 */
  .toc-desktop .toc-subs {
    margin-top: -7px;
  }

  .toc-desktop .toc-subs-inner {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 0.3s ease,
      opacity 0.25s ease;
  }

  .toc-desktop .toc-subs.expanded {
    margin-top: 0;
  }

  .toc-desktop .toc-subs.expanded .toc-subs-inner {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .toc-desktop .toc-subs-inner > ul {
    overflow: hidden;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  @media (prefers-reduced-motion: reduce) {
    .toc-desktop .toc-subs-inner {
      transition: none;
    }
  }

  /* 阅读进度轨道:沿目录左缘生长 */
  .toc-rail {
    position: absolute;
    left: -1px;
    top: 0;
    bottom: 0;
    width: 2px;
    pointer-events: none;
  }

  .toc-rail-fill {
    display: block;
    width: 100%;
    height: 0%;
    border-radius: 2px;
    background: var(--color-accent);
    opacity: 0.45;
    transition: height 0.1s linear;
  }

  .toc-percent {
    margin-top: 14px;
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--color-muted);
    opacity: 0.8;
  }

  .toc-percent:empty {
    display: none;
  }

  /* 层级表达分工:lv-0~2(对应正文的章节级)用缩进阶梯区分;
     lv-3~5(标注级)缩进与 lv-2 齐平,改用青色(contrast)+ 字号/透明度递进。
     :not(.is-current) 保证当前小节的珊瑚指示不被层级色盖住 */
  .toc-desktop .lv-1 {
    padding-left: 14px;
  }

  .toc-desktop .lv-2,
  .toc-desktop .lv-3,
  .toc-desktop .lv-4,
  .toc-desktop .lv-5 {
    padding-left: 26px;
  }

  .toc-desktop .lv-0 a:not(.is-current),
  .toc-desktop .lv-1 a:not(.is-current),
  .toc-desktop .lv-2 a:not(.is-current) {
    color: var(--color-accent);
  }

  .toc-desktop .lv-1 a {
    font-size: 12.5px;
  }

  .toc-desktop .lv-2 a {
    font-size: 12px;
  }

  .toc-desktop .lv-3 a:not(.is-current) {
    font-size: 12px;
    color: var(--color-contrast);
  }

  .toc-desktop .lv-4 a:not(.is-current) {
    font-size: 11.5px;
    color: var(--color-contrast);
    opacity: 0.8;
  }

  .toc-desktop .lv-5 a:not(.is-current) {
    font-size: 11px;
    color: var(--color-contrast);
    opacity: 0.6;
  }

  .toc-mobile {
    margin-bottom: 24px;
  }

  .toc-toggle {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    padding: 12px 16px;
    font-family: var(--font-ui);
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  :global(.toc-chevron) {
    margin-left: auto;
    transition: transform 0.25s ease;
  }

  .toc-toggle[aria-expanded='true'] :global(.toc-chevron) {
    transform: rotate(180deg);
  }

  .toc-panel {
    margin-top: 6px;
    padding: 14px 18px;
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .toc-panel a {
    display: block;
    padding: 6px 0;
    font-size: 14px;
    color: var(--color-muted);
  }

  .toc-panel a:hover {
    color: var(--color-accent-text);
  }

  .toc-panel .lv-1 {
    padding-left: 16px;
  }

  .toc-panel .lv-2,
  .toc-panel .lv-3,
  .toc-panel .lv-4,
  .toc-panel .lv-5 {
    padding-left: 30px;
  }

  .toc-panel .lv-0 a,
  .toc-panel .lv-1 a,
  .toc-panel .lv-2 a {
    color: var(--color-accent);
  }

  .toc-panel .lv-1 a {
    font-size: 13.5px;
  }

  .toc-panel .lv-2 a {
    font-size: 13px;
  }

  .toc-panel .lv-3 a {
    font-size: 12.5px;
    color: var(--color-contrast);
  }

  .toc-panel .lv-4 a {
    font-size: 12px;
    color: var(--color-contrast);
    opacity: 0.8;
  }

  .toc-panel .lv-5 a {
    font-size: 11.5px;
    color: var(--color-contrast);
    opacity: 0.6;
  }
</style>

<script>
  function initToc() {
    const toggle = document.querySelector<HTMLButtonElement>('[data-toc-toggle]');
    const panel = document.querySelector<HTMLElement>('[data-toc-panel]');
    if (toggle && panel) {
      toggle.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!open));
        if (open) {
          panel.hidden = true;
        } else {
          panel.hidden = false;
        }
      });
      panel.querySelectorAll('a').forEach((a) =>
        a.addEventListener('click', () => {
          panel.hidden = true;
          toggle.setAttribute('aria-expanded', 'false');
        }),
      );
    }

    // 滚动高亮当前小节(h1–h6);桌面目录与抽屉的链接同 slug,一对多映射
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
    if (links.length === 0) return;
    const map = new Map<string, HTMLAnchorElement[]>();
    links.forEach((l) => {
      const arr = map.get(l.dataset.tocLink!) ?? [];
      arr.push(l);
      map.set(l.dataset.tocLink!, arr);
    });

    // 族归属只看桌面目录的 DOM 结构(抽屉是平铺列表,不含 .toc-subs);
    // 桌面目录里,不在 .toc-subs 里的链接即族头
    const familyOf = new Map<string, string>();
    let curFamily = '';
    document
      .querySelectorAll<HTMLAnchorElement>('.toc-desktop [data-toc-link]')
      .forEach((l) => {
        if (!l.closest('.toc-subs')) curFamily = l.dataset.tocLink!;
        familyOf.set(l.dataset.tocLink!, curFamily);
      });
    const families = [...document.querySelectorAll<HTMLElement>('.toc-subs')];
    const setActiveFamily = (slug: string) => {
      const active = familyOf.get(slug);
      families.forEach((f) => {
        const on = f.dataset.family === active;
        f.classList.toggle('expanded', on);
        f.toggleAttribute('inert', !on);
        f.setAttribute('aria-hidden', String(!on));
      });
    };
    // 当前节判定:位置线规则——最后一个顶部越过判定线(导航底缘 74+20=94px)
    // 的标题为当前节;线以上没有标题(引言区)则不高亮。上下滚动对称,
    // 锚点跳转与快速滚动天然正确。
    const LINE = 94;
    const headingEls = [
      ...document.querySelectorAll<HTMLElement>('.prose :is(h1, h2, h3, h4, h5, h6)[id]'),
    ];

    const setCurrent = (id: string | null) => {
      links.forEach((l) => l.classList.remove('is-current'));
      if (id) {
        map.get(id)?.forEach((l) => l.classList.add('is-current'));
        setActiveFamily(id);
      } else {
        setActiveFamily('');
      }
    };

    let currentId: string | null = null;
    const updateCurrent = () => {
      let id: string | null = null;
      for (const h of headingEls) {
        if (h.getBoundingClientRect().top <= LINE) id = h.id;
        else break;
      }
      if (id !== currentId) {
        currentId = id;
        setCurrent(id);
      }
    };
    let tocTicking = false;
    const onTocScroll = () => {
      if (!tocTicking) {
        requestAnimationFrame(() => {
          updateCurrent();
          tocTicking = false;
        });
        tocTicking = true;
      }
    };
    window.addEventListener('scroll', onTocScroll, { passive: true });
    updateCurrent();
    document.addEventListener('astro:before-swap', () => window.removeEventListener('scroll', onTocScroll), {
      once: true,
    });

    // 目录初始位置与文章卡片的内容顶缘对齐(目录与正文两栏同高起读)
    const aside = document.querySelector<HTMLElement>('.article-aside');
    const card = document.querySelector<HTMLElement>('.article-card');
    if (aside && card) {
      const align = () => {
        if (!window.matchMedia('(min-width: 1280px)').matches) {
          aside.style.paddingTop = '';
          return;
        }
        aside.style.paddingTop = '0px';
        const cardPadTop = parseFloat(getComputedStyle(card).paddingTop) || 0;
        const delta = card.getBoundingClientRect().top + cardPadTop - aside.getBoundingClientRect().top;
        aside.style.paddingTop = `${Math.max(0, Math.round(delta))}px`;
      };
      align();
      document.fonts?.ready.then(align);
      window.addEventListener('resize', align);
      document.addEventListener(
        'astro:before-swap',
        () => window.removeEventListener('resize', align),
        { once: true },
      );
    }

    // 进度轨道 + 百分比
    const rail = document.querySelector<HTMLElement>('[data-toc-rail]');
    const percent = document.querySelector<HTMLElement>('[data-toc-percent]');
    if (rail || percent) {
      let ticking = false;
      const update = () => {
        const doc = document.documentElement;
        const total = doc.scrollHeight - doc.clientHeight;
        const p = total > 0 ? Math.min(1, doc.scrollTop / total) : 0;
        if (rail) rail.style.height = `${(p * 100).toFixed(1)}%`;
        if (percent) percent.textContent = `${Math.round(p * 100)}%`;
        ticking = false;
      };
      const onScroll = () => {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      update();
      document.addEventListener(
        'astro:before-swap',
        () => window.removeEventListener('scroll', onScroll),
        { once: true },
      );
    }
  }
  document.addEventListener('astro:page-load', initToc);
</script>
