---
import Icon from './Icon.astro';
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  variant: 'mobile' | 'desktop';
}

const { headings, variant } = Astro.props;
// 正文 h1–h6 全进目录;按实际最小层级归一化——正文有 h1 时 h2 自动降一级,
// 没有 h1 时 h2 即顶级;视觉层级 lv-0(顶级)到 lv-5,递进缩进弱化
const toc = headings.filter((h) => h.depth >= 1 && h.depth <= 6);
const minDepth = Math.min(...toc.map((h) => h.depth));
const levelOf = (depth: number) => Math.min(depth - minDepth, 5);

// 桌面侧栏渐进折叠:默认只显示顶级;滚动进入某节时,展开其祖先链上各层的
// 兄弟与当前节的下一级,离开立即收回。每条目记父节 slug 供脚本判定。
// 移动面板与抽屉始终完整展开(它们是主动打开看结构的场景)。
type TocEntry = { h: (typeof toc)[number]; lv: number; parent: string };
const items: TocEntry[] = [];
const stack: { lv: number; slug: string }[] = [];
for (const h of toc) {
  const lv = levelOf(h.depth);
  while (stack.length && stack[stack.length - 1].lv >= lv) stack.pop();
  items.push({ h, lv, parent: stack.length ? stack[stack.length - 1].slug : '' });
  stack.push({ lv, slug: h.slug });
}
---

{
  toc.length > 0 && variant === 'mobile' && (
    <div class="toc-mobile">
      <button
        type="button"
        class="toc-toggle"
        data-toc-toggle
        aria-expanded="false"
        aria-controls="toc-panel"
      >
        <Icon name="list" size={15} />
        <span>本文目录</span>
        <Icon name="chevron-down" size={14} class="toc-chevron" />
      </button>
      <nav class="toc-panel" id="toc-panel" data-toc-panel hidden aria-label="文章目录">
        <ul>
          {toc.map((h) => (
            <li class={`lv-${levelOf(h.depth)}`}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  )
}

{
  toc.length > 0 && variant === 'desktop' && (
    <nav class="toc-desktop" aria-label="文章目录">
      {/* 只有「CONTENTS 标题 + 目录列表」是滚动区;
          百分比钉在底部、进度轨道锚定可视高度,都不随列表滚动 */}
      <div class="toc-scroll">
        <p class="toc-heading font-mono">CONTENTS</p>
        <ul>
          {items.map((it) => (
            <li
              class={`lv-${it.lv}${it.parent ? ' collapsed' : ''}`}
              data-toc-item={it.h.slug}
              data-parent={it.parent || undefined}
              inert={it.parent ? true : undefined}
              aria-hidden={it.parent ? 'true' : undefined}
            >
              <a href={`#${it.h.slug}`} data-toc-link={it.h.slug} title={it.h.text}>
                <span class="toc-label" data-toc-label>{it.h.text}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
      <p class="toc-percent font-mono" data-toc-percent aria-hidden="true" />
      <span class="toc-rail" aria-hidden="true">
        <span class="toc-rail-fill" data-toc-rail />
      </span>
    </nav>
  )
}

<style>
  .toc-desktop {
    position: sticky;
    top: 96px;
    max-height: calc(100svh - 140px);
    display: flex;
    flex-direction: column;
    /* 整个「脊柱+文字」单元按内容取宽,在 aside 栏内左右居中 */
    width: fit-content;
    max-width: 100%;
    margin-inline: auto;
    border-left: 1px solid var(--color-border);
  }

  /* 滚动区:只有它在超长时滚动;滚动条隐藏——目录滚动是兜底行为,
     不该成为视觉元素(当前位置由 is-current 与进度轨道表达) */
  .toc-scroll {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    /* 19px = 18px 原缩进 + 1px,给 is-current 指示条(left:-19px)留出不裁切的余量 */
    padding-left: 19px;
    scrollbar-width: none;
  }

  .toc-scroll::-webkit-scrollbar {
    display: none;
  }

  .toc-heading {
    font-size: var(--text-xs);
    font-weight: var(--weight-label);
    letter-spacing: 0.04em;
    color: var(--color-muted);
    margin-bottom: 12px;
  }

  .toc-desktop ul,
  .toc-panel ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  /* 渐进折叠:li 自身做 0fr↔1fr 收放(不再按族分组);负 margin 抵消 flex gap,
     折叠不留空位。非顶级初始即 collapsed(SSR 直出,JS 就位后按当前节展开) */
  .toc-desktop li {
    display: grid;
    grid-template-rows: 1fr;
    transition:
      grid-template-rows 0.3s ease,
      opacity 0.25s ease;
  }

  .toc-desktop li.collapsed {
    grid-template-rows: 0fr;
    opacity: 0;
    margin-top: -8px;
    pointer-events: none;
  }

  .toc-desktop a {
    position: relative;
    display: block;
    min-height: 0;
    font-size: var(--text-xl);
    font-weight: var(--weight-label);
    line-height: 1.55;
    color: var(--color-muted);
    overflow: hidden;
    transition: color 0.2s ease;
  }

  .toc-desktop .toc-label {
    display: -webkit-box;
    width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  /* 每行横线按 Range 量出的实际字宽单独绘制，便于独立反向和并行。
     末端墨尾与亮边按可见宽度重排，不随整条线一起被横向缩放。 */
  .toc-desktop :global(.toc-ink-line) {
    position: absolute;
    height: 1.5px;
    overflow: hidden;
    border-radius: 999px;
    background: linear-gradient(
      90deg,
      currentColor 0,
      currentColor 52%,
      color-mix(in srgb, currentColor 24%, transparent) calc(100% - 8px),
      transparent 100%
    );
    filter: drop-shadow(0 0 2.5px color-mix(in srgb, currentColor 17%, transparent));
    pointer-events: none;
    will-change: width;
  }

  /* 运动笔尖只是更淡的同色墨，不向正文色提深。 */
  .toc-desktop :global(.toc-ink-line::after) {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 18px;
    border-radius: inherit;
    background: linear-gradient(
      90deg,
      transparent 0,
      color-mix(in srgb, currentColor 30%, var(--color-canvas)) 55%,
      transparent 100%
    );
    opacity: 0;
    transition: opacity 80ms ease;
  }

  .toc-desktop :global(.toc-ink-line.is-moving::after) {
    opacity: 1;
  }

  .toc-desktop :global(.toc-ink-line.is-tip-fading::after) {
    opacity: 0;
  }

  .toc-desktop a:hover {
    color: var(--color-text);
  }

  /* 当前小节:加粗 + 下划线 + 左侧指示条,全部随本级色相的全强度版本
     (currentColor),不再让珊瑚压住所有级 */
  .toc-desktop a.is-current {
    font-weight: 600;
  }

  .toc-desktop .lv-0 a.is-current,
  .toc-desktop .lv-2 a.is-current,
  .toc-desktop .lv-4 a.is-current {
    color: var(--color-accent-text);
  }

  .toc-desktop .lv-1 a.is-current,
  .toc-desktop .lv-3 a.is-current,
  .toc-desktop .lv-5 a.is-current {
    color: var(--color-contrast);
  }

  .toc-desktop a.is-current::before {
    content: '';
    position: absolute;
    left: -19px;
    top: 2px;
    bottom: 2px;
    width: 2px;
    border-radius: 2px;
    background: currentColor;
  }

  /* 深层级收放已由渐进折叠取代(见上方 li.collapsed);保留 reduced-motion 兜底 */
  @media (prefers-reduced-motion: reduce) {
    .toc-desktop li {
      transition: none;
    }
  }

  /* 阅读进度轨道:沿目录左缘生长。宿主 .toc-desktop 自身不滚动,
     top:0/bottom:0 锚定的就是可视高度——列表再长轨道也不跟着延长 */
  .toc-rail {
    position: absolute;
    left: -1px;
    top: 0;
    bottom: 0;
    width: 2px;
    pointer-events: none;
  }

  .toc-rail-fill {
    display: block;
    width: 100%;
    height: 0%;
    border-radius: 2px;
    background: var(--color-accent);
    opacity: 0.45;
    transition: height 0.1s linear;
  }

  .toc-percent {
    flex-shrink: 0; /* 钉在目录底部,不随滚动区滚动 */
    padding-left: 19px;
    margin-top: 14px;
    font-size: var(--text-xs);
    font-weight: var(--weight-label);
    letter-spacing: 0.06em;
    color: var(--color-muted);
  }

  .toc-percent:empty {
    display: none;
  }

  /* 层级表达分工:lv-0~2(对应正文的章节级)用缩进阶梯区分;
     lv-3~5(标注级)缩进与 lv-2 齐平,改用青色(contrast)+ 字号/透明度递进。
     :not(.is-current) 保证当前小节的珊瑚指示不被层级色盖住 */
  .toc-desktop .lv-1 {
    padding-left: 14px;
  }

  .toc-desktop .lv-2,
  .toc-desktop .lv-3,
  .toc-desktop .lv-4,
  .toc-desktop .lv-5 {
    padding-left: 26px;
  }

  /* 层级配色:偶数级珊瑚(accent-text)、奇数级青(contrast),交替提供相邻区分;
     随深度向 muted 淡化承担全局深度感,但 lv5 仍保留 55% 色相合量——
     淡过头两色相会在深层趋同,交替就失去意义。
     混合而非 opacity:两个端点对比度都 ≥4.5,混合不会跌穿 */
  .toc-desktop .lv-0 a:not(.is-current) {
    /* accent 直接上字对比度不足(4.16),用文字级 accent-text */
    color: var(--color-accent-text);
  }

  .toc-desktop .lv-1 a {
    font-size: var(--text-lg);
  }

  .toc-desktop .lv-2 a {
    font-size: var(--text-md);
  }

  .toc-desktop .lv-1 a:not(.is-current) {
    color: color-mix(in oklab, var(--color-contrast) 88%, var(--color-muted));
  }

  .toc-desktop .lv-2 a:not(.is-current) {
    color: color-mix(in oklab, var(--color-accent-text) 78%, var(--color-muted));
  }

  /* lv-3~5 字号触底 13px 下限,层级只靠色递进(opacity 会击穿对比度)。
     字号必须与 :not(.is-current) 的颜色规则分离——否则聚焦时字号规则失效,
     文字会跳回基础字号(16px)突然变大 */
  .toc-desktop .lv-3 a,
  .toc-desktop .lv-4 a,
  .toc-desktop .lv-5 a {
    font-size: var(--text-sm);
  }

  .toc-desktop .lv-3 a:not(.is-current) {
    color: color-mix(in oklab, var(--color-contrast) 68%, var(--color-muted));
  }

  .toc-desktop .lv-4 a:not(.is-current) {
    color: color-mix(in oklab, var(--color-accent-text) 60%, var(--color-muted));
  }

  .toc-desktop .lv-5 a:not(.is-current) {
    color: color-mix(in oklab, var(--color-contrast) 55%, var(--color-muted));
  }

  .toc-mobile {
    margin-bottom: 24px;
  }

  .toc-toggle {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    padding: 12px 16px;
    font-family: var(--font-ui);
    font-size: var(--text-md);
    font-weight: 500;
    color: var(--color-text);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  :global(.toc-chevron) {
    margin-left: auto;
    transition: transform 0.25s ease;
  }

  .toc-toggle[aria-expanded='true'] :global(.toc-chevron) {
    transform: rotate(180deg);
  }

  .toc-panel {
    margin-top: 6px;
    padding: 14px 18px;
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .toc-panel a {
    display: block;
    padding: 6px 0;
    font-size: 16px;
    font-weight: var(--weight-label);
    color: var(--color-muted);
  }

  .toc-panel a:hover {
    color: var(--color-accent-text);
  }

  .toc-panel .lv-1 {
    padding-left: 16px;
  }

  .toc-panel .lv-2,
  .toc-panel .lv-3,
  .toc-panel .lv-4,
  .toc-panel .lv-5 {
    padding-left: 30px;
  }

  /* 与桌面目录同一套层级色相:偶数级珊瑚、奇数级青、随深度向 muted 淡化 */
  .toc-panel .lv-0 a {
    color: var(--color-accent-text);
  }

  .toc-panel .lv-1 a {
    font-size: var(--text-lg);
    color: color-mix(in oklab, var(--color-contrast) 88%, var(--color-muted));
  }

  .toc-panel .lv-2 a {
    font-size: var(--text-md);
    color: color-mix(in oklab, var(--color-accent-text) 78%, var(--color-muted));
  }

  .toc-panel .lv-3 a {
    font-size: var(--text-sm);
    color: color-mix(in oklab, var(--color-contrast) 68%, var(--color-muted));
  }

  .toc-panel .lv-4 a {
    font-size: var(--text-sm);
    color: color-mix(in oklab, var(--color-accent-text) 60%, var(--color-muted));
  }

  .toc-panel .lv-5 a {
    font-size: var(--text-sm);
    color: color-mix(in oklab, var(--color-contrast) 55%, var(--color-muted));
  }
</style>

<script>
  function initToc() {
    const toggle = document.querySelector<HTMLButtonElement>('[data-toc-toggle]');
    const panel = document.querySelector<HTMLElement>('[data-toc-panel]');
    if (toggle && panel) {
      toggle.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!open));
        if (open) {
          panel.hidden = true;
        } else {
          panel.hidden = false;
        }
      });
      panel.querySelectorAll('a').forEach((a) =>
        a.addEventListener('click', () => {
          panel.hidden = true;
          toggle.setAttribute('aria-expanded', 'false');
        }),
      );
    }

    // 滚动高亮当前小节(h1–h6);桌面目录与抽屉的链接同 slug,一对多映射
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
    if (links.length === 0) return;
    const map = new Map<string, HTMLAnchorElement[]>();
    links.forEach((l) => {
      const arr = map.get(l.dataset.tocLink!) ?? [];
      arr.push(l);
      map.set(l.dataset.tocLink!, arr);
    });

    // 渐进折叠(仅桌面):条目可见 ⟺ 它是顶级,或父节在「当前节 ∪ 其祖先链」里;
    // 离开某节其子级立即收回,不多展开。父链由 SSR 写在 data-parent 上
    const tocItems = [...document.querySelectorAll<HTMLElement>('.toc-desktop [data-toc-item]')];
    const parentOf = new Map<string, string>();
    tocItems.forEach((el) => parentOf.set(el.dataset.tocItem!, el.dataset.parent ?? ''));
    const applyVisibility = (currentId: string | null) => {
      const open = new Set<string>();
      for (let cur: string | null = currentId; cur; ) {
        open.add(cur);
        cur = parentOf.get(cur) || null;
      }
      tocItems.forEach((el) => {
        const vis = !el.dataset.parent || open.has(el.dataset.parent);
        el.classList.toggle('collapsed', !vis);
        el.toggleAttribute('inert', !vis);
        el.setAttribute('aria-hidden', String(!vis));
      });
    };
    // 当前节判定:位置线规则——最后一个顶部越过判定线(导航底缘 74+20=94px)
    // 的标题为当前节;线以上没有标题(引言区)则不高亮。上下滚动对称,
    // 锚点跳转与快速滚动天然正确。
    const LINE = 94;
    const headingEls = [
      ...document.querySelectorAll<HTMLElement>('.prose :is(h1, h2, h3, h4, h5, h6)[id]'),
    ];

    type InkLine = {
      fill: HTMLSpanElement;
      fullWidth: number;
      raf: number;
      timer: number;
      generation: number;
    };
    const inks = new WeakMap<HTMLAnchorElement, InkLine[]>();
    const inkLineSet = new Set<InkLine>();
    const INK_MS = 170;
    const INK_STAGGER_MS = 60;
    const INK_MIN_MS = 50;
    const INK_EASE = 'cubic-bezier(0.22, 1, 0.36, 1)';
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const desktopLinksFor = (id: string | null): HTMLAnchorElement[] =>
      id ? (map.get(id) ?? []).filter((link) => !!link.closest('.toc-desktop')) : [];

    const inkProgress = (line: InkLine): number => {
      const visible = line.fill.getBoundingClientRect().width;
      return line.fullWidth > 0 ? Math.min(1, Math.max(0, visible / line.fullWidth)) : 0;
    };

    const clearInkActivity = (line: InkLine): void => {
      if (line.raf) cancelAnimationFrame(line.raf);
      if (line.timer) clearTimeout(line.timer);
      line.raf = 0;
      line.timer = 0;
      line.generation++;
    };

    const stopTip = (line: InkLine): void => {
      line.fill.classList.remove('is-moving', 'is-tip-fading');
    };

    /** 从当前实际长度反向；快速切换时按剩余距离缩短时长。 */
    const animateInkLine = (line: InkLine, target: 0 | 1, delay: number): void => {
      clearInkActivity(line);
      const { fill, fullWidth } = line;
      const from = inkProgress(line);
      const targetWidth = fullWidth * target;
      // 先冻结到当前宽度；可见宽度动画不会把固定长度的墨尾和亮端一起缩放。
      fill.style.transition = 'none';
      fill.style.width = `${fullWidth * from}px`;
      void fill.offsetWidth;
      const distance = Math.abs(target - from);
      if (distance < 0.001) {
        fill.style.width = `${targetWidth}px`;
        stopTip(line);
        return;
      }
      if (reduceMotion.matches) {
        fill.style.width = `${targetWidth}px`;
        stopTip(line);
        return;
      }

      const duration = Math.max(INK_MIN_MS, INK_MS * distance);
      const generation = line.generation;
      fill.classList.remove('is-tip-fading');
      fill.classList.add('is-moving');
      if (target === 0 && from <= 0.1) fill.classList.add('is-tip-fading');
      fill.style.transition = `width ${duration}ms ${INK_EASE} ${delay}ms`;
      fill.style.width = `${targetWidth}px`;

      // 收束进入最后 10% 时提前抽掉亮端，避免左端残留亮点。
      if (target === 0 && from > 0.1) {
        const tick = (): void => {
          if (generation !== line.generation) return;
          if (inkProgress(line) <= 0.1) {
            fill.classList.add('is-tip-fading');
            line.raf = 0;
            return;
          }
          line.raf = requestAnimationFrame(tick);
        };
        line.raf = requestAnimationFrame(tick);
      }

      line.timer = window.setTimeout(() => {
        if (generation !== line.generation) return;
        line.timer = 0;
        stopTip(line);
      }, delay + duration);
    };

    /** 每个视觉行各画一条实际字宽的墨线；快速切换时各线可独立反向。 */
    const buildInk = (link: HTMLAnchorElement): InkLine[] => {
      const existing = inks.get(link);
      if (existing) return existing;
      const label = link.querySelector<HTMLElement>('[data-toc-label]');
      if (!label) return [];
      const range = document.createRange();
      range.selectNodeContents(label);
      const lineRects = [...range.getClientRects()].filter((rect) => rect.width > 0 && rect.height > 0);
      if (lineRects.length === 0) return [];
      const linkRect = link.getBoundingClientRect();
      const lines: InkLine[] = lineRects.map((rect) => {
        const fullWidth = rect.width;
        const fill = document.createElement('span');
        fill.className = 'toc-ink-line';
        fill.setAttribute('aria-hidden', 'true');
        fill.style.left = `${rect.left - linkRect.left}px`;
        // 下移 1.5px，并统一落在半像素相位；避免同一高度的两行被栅格化成 1/2 行。
        const inkTop = rect.bottom - linkRect.top - 0.75;
        fill.style.top = `${Math.floor(inkTop) + 0.5}px`;
        fill.style.width = '0px';
        link.append(fill);
        const line: InkLine = { fill, fullWidth, raf: 0, timer: 0, generation: 0 };
        inkLineSet.add(line);
        return line;
      });
      inks.set(link, lines);
      return lines;
    };

    const transitionInk = (link: HTMLAnchorElement, entering: boolean, immediate = false): void => {
      const lines = buildInk(link);
      lines.forEach((line, i) => {
        if (immediate) {
          clearInkActivity(line);
          line.fill.style.transition = 'none';
          line.fill.style.width = `${line.fullWidth}px`;
          stopTip(line);
          return;
        }
        // 进入自上而下，退出自下而上；两侧同一拍开始。
        const delay = entering ? i * INK_STAGGER_MS : (lines.length - 1 - i) * INK_STAGGER_MS;
        animateInkLine(line, entering ? 1 : 0, delay);
      });
    };
    let currentId: string | null = null;
    let firstFocus = true;

    const setCurrent = (id: string | null, immediate = false): void => {
      const previous = desktopLinksFor(currentId);
      const nextAll = id ? (map.get(id) ?? []) : [];
      const nextDesktop = desktopLinksFor(id);
      links.forEach((link) => link.classList.remove('is-current'));
      // 抽屉等其他目录仍沿用原有的 is-current 状态；动画只作用于桌面目录。
      nextAll.forEach((link) => link.classList.add('is-current'));
      applyVisibility(id);
      // 两个方向并行：不等待旧项收完，也不让更早的收束排进队列。
      previous.forEach((link) => transitionInk(link, false));
      nextDesktop.forEach((link) => transitionInk(link, true, immediate));
      currentId = id;
    };

    const refreshCurrentInk = (): void => {
      document.querySelectorAll<HTMLAnchorElement>('.toc-desktop a.is-current').forEach((link) => {
        inks.get(link)?.forEach((line) => {
          clearInkActivity(line);
          line.fill.remove();
          inkLineSet.delete(line);
        });
        inks.delete(link);
        transitionInk(link, true, true);
      });
    };
    let inkResizeFrame = 0;
    const scheduleInkRefresh = (): void => {
      if (inkResizeFrame) cancelAnimationFrame(inkResizeFrame);
      inkResizeFrame = requestAnimationFrame(() => {
        inkResizeFrame = 0;
        refreshCurrentInk();
      });
    };
    window.addEventListener('resize', scheduleInkRefresh);
    document.fonts?.ready.then(() => {
      if (links[0]?.isConnected) scheduleInkRefresh();
    });
    document.addEventListener(
      'astro:before-swap',
      () => {
        window.removeEventListener('resize', scheduleInkRefresh);
        if (inkResizeFrame) cancelAnimationFrame(inkResizeFrame);
        inkLineSet.forEach(clearInkActivity);
        inkLineSet.clear();
      },
      { once: true },
    );

    const updateCurrent = () => {
      let id: string | null = null;
      for (const h of headingEls) {
        if (h.getBoundingClientRect().top <= LINE) id = h.id;
        else break;
      }
      if (id !== currentId) {
        const initial = !!id && firstFocus;
        if (id) firstFocus = false;
        setCurrent(id, initial);
      }
    };
    let tocTicking = false;
    const onTocScroll = () => {
      if (!tocTicking) {
        requestAnimationFrame(() => {
          updateCurrent();
          tocTicking = false;
        });
        tocTicking = true;
      }
    };
    window.addEventListener('scroll', onTocScroll, { passive: true });
    updateCurrent();
    document.addEventListener('astro:before-swap', () => window.removeEventListener('scroll', onTocScroll), {
      once: true,
    });

    // 目录初始位置与文章卡片的内容顶缘对齐(目录与正文两栏同高起读)
    const aside = document.querySelector<HTMLElement>('.article-aside');
    const card = document.querySelector<HTMLElement>('.article-card');
    if (aside && card) {
      const align = () => {
        if (!window.matchMedia('(min-width: 1280px)').matches) {
          aside.style.paddingTop = '';
          return;
        }
        aside.style.paddingTop = '0px';
        const cardPadTop = parseFloat(getComputedStyle(card).paddingTop) || 0;
        const delta = card.getBoundingClientRect().top + cardPadTop - aside.getBoundingClientRect().top;
        aside.style.paddingTop = `${Math.max(0, Math.round(delta))}px`;
      };
      align();
      document.fonts?.ready.then(align);
      window.addEventListener('resize', align);
      document.addEventListener(
        'astro:before-swap',
        () => window.removeEventListener('resize', align),
        { once: true },
      );
    }

    // 进度轨道 + 百分比
    const rail = document.querySelector<HTMLElement>('[data-toc-rail]');
    const percent = document.querySelector<HTMLElement>('[data-toc-percent]');
    if (rail || percent) {
      let ticking = false;
      const update = () => {
        const doc = document.documentElement;
        const total = doc.scrollHeight - doc.clientHeight;
        const p = total > 0 ? Math.min(1, doc.scrollTop / total) : 0;
        if (rail) rail.style.height = `${(p * 100).toFixed(1)}%`;
        if (percent) percent.textContent = `${Math.round(p * 100)}%`;
        ticking = false;
      };
      const onScroll = () => {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      update();
      document.addEventListener(
        'astro:before-swap',
        () => window.removeEventListener('scroll', onScroll),
        { once: true },
      );
    }
  }
  document.addEventListener('astro:page-load', initToc);
</script>
