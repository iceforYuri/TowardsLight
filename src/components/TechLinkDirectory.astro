---
import TechLinkRow from './TechLinkRow.astro';
import TechLinkCard from './TechLinkCard.astro';
import { linksByGroup, type TechLink } from '../data/links';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const groups = linksByGroup();
---

<div class="tech-directory">
  {
    groups.map((group) => {
      let links = group.links;
      if (links.length === 0) return null;
      if (compact) {
        links = links.filter((l) => l.featured);
        if (links.length === 0) return null;
      }
      const featured = compact ? [] : links.filter((l) => l.featured);
      const normal = compact ? links : links.filter((l) => !l.featured);
      return (
        <section class="link-group" data-tone={'tone' in group ? group.tone : undefined}>
          <h2 class="group-title font-ui">
            <span class="group-marker" aria-hidden="true" />
            {group.label}
            <span class="group-count font-mono">{links.length}</span>
          </h2>
          {featured.length > 0 && (
            <div class="featured-grid">
              {featured.map((link: TechLink) => (
                <TechLinkCard link={link} />
              ))}
            </div>
          )}
          {normal.length > 0 && (
            <div class="row-list">
              {normal.map((link: TechLink) => (
                <TechLinkRow link={link} />
              ))}
            </div>
          )}
        </section>
      );
    })
  }
</div>

<style>
  .tech-directory {
    display: flex;
    flex-direction: column;
    gap: 44px;
  }

  .group-title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 14px;
  }

  .group-marker {
    width: 16px;
    height: 2px;
    background: var(--color-accent);
    border-radius: 2px;
  }

  .group-count {
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--color-muted);
    opacity: 0.7;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 14px;
    margin-bottom: 10px;
  }

  .row-list {
    display: flex;
    flex-direction: column;
  }

  .row-list :global(.tech-link-row + .tech-link-row) {
    border-top: 1px solid var(--color-border);
    border-radius: 0;
  }

  /* ── 分组整色:linkGroups[].tone 声明后,整个栏目浸染为该色系 ──
     纪律:彩色分组不超过 3 个,全彩会滑向资源导航站 */
  .link-group[data-tone] {
    background: var(--gt-soft);
    border: 1px solid color-mix(in oklab, var(--gt) 26%, transparent);
    border-radius: 20px;
    padding: 20px 20px 10px;
  }
  .link-group[data-tone='steel'] {
    --gt: var(--color-steel);
    --gt-soft: var(--color-steel-soft);
  }
  .link-group[data-tone='contrast'] {
    --gt: var(--color-contrast);
    --gt-soft: var(--color-contrast-soft);
  }
  .link-group[data-tone='accent'] {
    --gt: var(--color-accent);
    --gt-soft: var(--color-accent-soft);
  }

  .link-group[data-tone] .group-title {
    color: var(--gt);
  }
  .link-group[data-tone] .group-marker {
    background: var(--gt);
  }
  .link-group[data-tone] .group-count {
    color: var(--gt);
    opacity: 0.75;
  }

  /* 组内行/卡统一归入组色:图标徽章、hover、外链箭头、精选卡、分隔线 */
  .link-group[data-tone] :global(.link-icon) {
    background: color-mix(in oklab, var(--gt) 14%, var(--color-surface));
    color: var(--gt);
  }
  .link-group[data-tone] :global(.tech-link-row:hover) {
    background: color-mix(in oklab, var(--gt) 9%, transparent);
  }
  .link-group[data-tone] :global(.tech-link-row:hover .link-external) {
    color: var(--gt);
    opacity: 0.9;
  }
  .link-group[data-tone] .row-list :global(.tech-link-row + .tech-link-row) {
    border-top-color: color-mix(in oklab, var(--gt) 18%, transparent);
  }
  .link-group[data-tone] :global(.tech-link-card) {
    background: var(--color-surface);
    border-color: color-mix(in oklab, var(--gt) 24%, var(--color-border));
  }
  .link-group[data-tone] :global(.tech-link-card:hover) {
    border-color: var(--gt);
  }
  .link-group[data-tone] :global(.tech-link-card .card-icon) {
    color: var(--gt);
    border-color: color-mix(in oklab, var(--gt) 24%, var(--color-border));
  }
  .link-group[data-tone] :global(.tech-link-card:hover .card-external) {
    color: var(--gt);
  }

  /* 深色主题:浸染底在炭面上偏薄,补一点表面明度差 */
  :global(html[data-theme='dark']) .link-group[data-tone] {
    background: color-mix(in oklab, var(--gt-soft) 70%, var(--color-surface));
  }
</style>
