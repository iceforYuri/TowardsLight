---
import Icon from './Icon.astro';
import type { TechLink } from '../data/links';

interface Props {
  link: TechLink;
  /** 所在分组的整组色调;缺省保持珊瑚精选样式 */
  tone?: string;
}

const { link, tone } = Astro.props;
---

<a
  href={link.href}
  class="tech-link-card"
  data-tone={tone || undefined}
  {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
>
  <div class="card-top">
    <span class="card-icon" aria-hidden="true">
      <Icon name={link.icon ?? 'link'} size={19} />
    </span>
    {link.external && (
      <span class="card-external" aria-hidden="true">
        <Icon name="arrow-up-right" size={15} />
      </span>
    )}
  </div>
  <h3 class="card-title">{link.title}</h3>
  <p class="card-desc">{link.description}</p>
  {link.status && <span class="card-status font-mono">{link.status}</span>}
</a>

<style>
  .tech-link-card {
    display: flex;
    flex-direction: column;
    padding: 20px;
    background: var(--color-accent-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text);
    transition:
      border-color 0.25s ease,
      box-shadow 0.25s ease,
      transform 0.25s ease;
  }

  .tech-link-card:hover {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-raised);
    transform: translateY(-2px);
    color: var(--color-text);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 14px;
  }

  .card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-accent-text);
  }

  .card-external {
    color: var(--color-muted);
    transition:
      transform 0.2s ease,
      color 0.2s ease;
  }

  .tech-link-card:hover .card-external {
    transform: translate(2px, -2px);
    color: var(--color-accent-text);
  }

  .card-title {
    font-family: var(--font-ui);
    font-size: 16px;
    font-weight: 600;
  }

  .card-desc {
    margin-top: 5px;
    font-size: 13.5px;
    line-height: 1.65;
    color: var(--color-muted);
    flex: 1;
  }

  .card-status {
    margin-top: 12px;
    align-self: flex-start;
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--color-contrast);
    background: var(--color-contrast-soft);
    padding: 2px 9px;
    border-radius: 999px;
  }

  /* 分组整色(首页精选卡按所在分组的 tone 着色;Links 页则由分组 section 级联,两者一致) */
  .tech-link-card[data-tone='steel'] {
    --gt: var(--color-steel);
    --gt-soft: var(--color-steel-soft);
  }
  .tech-link-card[data-tone='contrast'] {
    --gt: var(--color-contrast);
    --gt-soft: var(--color-contrast-soft);
  }
  .tech-link-card[data-tone] {
    background: var(--gt-soft);
  }
  .tech-link-card[data-tone]:hover {
    border-color: var(--gt);
  }
  .tech-link-card[data-tone] .card-icon {
    color: var(--gt);
  }
  .tech-link-card[data-tone]:hover .card-external {
    color: var(--gt);
  }

  /* 移动端单列堆叠时收敛强调色面积(带分组色调的卡保留色调,它是身份而非强调) */
  @media (max-width: 640px) {
    .tech-link-card:not([data-tone]) {
      background: var(--color-surface-raised);
    }
  }
</style>
