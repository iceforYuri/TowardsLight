---
import Icon from './Icon.astro';
import type { TechLink } from '../data/links';

interface Props {
  link: TechLink;
  /** 所在分组的整组色调;缺省保持珊瑚精选样式 */
  tone?: string;
}

const { link, tone } = Astro.props;
---

<a
  href={link.href}
  class="tech-link-card"
  data-tone={tone || undefined}
  {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
>
  <div class="card-top">
    <span class="card-icon" aria-hidden="true">
      <Icon name={link.icon ?? 'link'} size={19} />
    </span>
    {link.external && (
      <span class="card-external" aria-hidden="true">
        <Icon name="arrow-up-right" size={15} />
      </span>
    )}
  </div>
  <h3 class="card-title">{link.title}</h3>
  <p class="card-desc">{link.description}</p>
  {link.status && <span class="card-status font-mono">{link.status}</span>}
  <svg class="card-trace" aria-hidden="true"><path pathLength="100" /></svg>
</a>

<style>
  .tech-link-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 20px;
    /* 中性面:精选的身份由卡片形态承担,颜色只表示组色(data-tone) */
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text);
    transition:
      border-color 0.25s ease,
      box-shadow 0.25s ease,
      transform 0.25s ease;
  }

  .tech-link-card:hover {
    box-shadow: var(--shadow-raised);
    transform: translateY(-2px);
    color: var(--color-text);
  }

  /* 环绕描边:贴边框路径画一圈,hover 从左上角顺时针长出(先快后慢),离开反向收回(先慢后快)。 */
  /* 颜色跟随卡片身份:组色卡用 --gt,中性卡用灰色兜底。路径由 card-trace.ts 从顶部中心生成,使用 pathLength=100 归一化动画 */
  .card-trace {
    position: absolute;
    inset: -1px;
    width: calc(100% + 2px);
    height: calc(100% + 2px);
    pointer-events: none;
  }

  .card-trace path {
    fill: none;
    stroke: var(--gt, color-mix(in oklab, var(--color-muted) 70%, var(--color-border)));
    stroke-width: 1.5px;
    stroke-linecap: round;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    opacity: 0;
    transition:
      stroke-dashoffset 0.5s cubic-bezier(0.55, 0.06, 0.68, 0.19),
      opacity 0s;
  }

  .card-trace[data-trace-ready] path {
    opacity: 1;
  }

  .tech-link-card:hover .card-trace path,
  .tech-link-card:focus-visible .card-trace path {
    stroke-dashoffset: 0;
    transition:
      stroke-dashoffset 0.6s cubic-bezier(0.22, 0.61, 0.36, 1),
      opacity 0s;
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 14px;
  }

  .card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-muted);
  }

  .card-external {
    color: var(--color-muted);
    transition:
      transform 0.2s ease,
      color 0.2s ease;
  }

  .tech-link-card:hover .card-external {
    transform: translate(2px, -2px);
    color: var(--color-text);
  }

  .card-title {
    font-family: var(--font-ui);
    font-size: 16px;
    font-weight: 600;
  }

  .card-desc {
    margin-top: 5px;
    font-size: var(--text-sm);
    font-weight: var(--weight-label);
    line-height: 1.65;
    /* 组色浸染底上 muted 对比度不足,向正文色混入 15% 兜底 */
    color: color-mix(in oklab, var(--color-muted) 85%, var(--color-text));
    flex: 1;
  }

  .card-status {
    margin-top: 12px;
    align-self: flex-start;
    font-size: var(--text-sm);
    font-weight: var(--weight-label);
    letter-spacing: 0.04em;
    /* 组色浸染底上 contrast 对比度不足,向正文色混入 25% 兜底 */
    color: color-mix(in oklab, var(--color-contrast) 75%, var(--color-text));
    background: var(--color-contrast-soft);
    padding: 2px 9px;
    border-radius: 999px;
  }

  /* 组色(首页按所在分组的 tone 传入;Links 页由分组 section 级联,两者一致) */
  .tech-link-card[data-tone='steel'] {
    --gt: var(--color-steel);
    --gt-soft: var(--color-steel-soft);
  }
  .tech-link-card[data-tone='contrast'] {
    --gt: var(--color-contrast);
    --gt-soft: var(--color-contrast-soft);
  }
  .tech-link-card[data-tone='accent'] {
    --gt: var(--color-accent);
    --gt-soft: var(--color-accent-soft);
  }
  .tech-link-card[data-tone] {
    background: var(--gt-soft);
  }
  .tech-link-card[data-tone] .card-icon {
    color: var(--gt);
  }
  .tech-link-card[data-tone]:hover .card-external {
    color: var(--gt);
  }
</style>

<script>
  import '../scripts/card-trace';
</script>
