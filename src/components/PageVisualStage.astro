---
/**
 * 页面顶部视觉区域:可选背景图 + 页面标题 + 展开/折叠
 * 无图片时退化为纯色主题背景
 */
import Icon from './Icon.astro';
import { u } from '../utils/url';
import { imageTreatment, sampleImageLuminance } from '../utils/image-luminance';

interface Props {
  title: string;
  description?: string;
  image?: string;
  meta?: string;
}

const { title, description, image, meta } = Astro.props;
// 构建期采样背景图底部(文字所在区)亮度:决定图上文字模式与遮罩强度
const imgLum = await sampleImageLuminance(image, 'stage');
const treatment = imageTreatment(imgLum);
const imgMode = treatment?.mode ?? null;
// 打字机文本:去掉行尾句号，由闪烁的下划线光标接替终止符
const typedDesc = description?.replace(/。\s*$/, '');
/** meta 行拆段:数字包成计数段,打字光标经过时翻滚 */
const metaSegments = meta
  ? meta
      .split(/(\d+)/)
      .filter(Boolean)
      .map((part) => (/^\d+$/.test(part) ? { n: Number(part) } : { t: part }))
  : [];
---

<section class="page-stage" data-stage data-img-mode={imgMode} style={treatment ? `--img-scrim: ${treatment.scrim}; --img-scrim-dark: ${treatment.scrimDark}` : undefined}>
  {
    image && (
      <div class="stage-backdrop" aria-hidden="true" transition:name="stage-media">
        <img
          src={u(image)}
          alt=""
          class="stage-img img-reveal"
          loading="eager"
          decoding="async"
          onload="this.classList.add('is-loaded')"
          onerror="this.closest('.stage-backdrop').remove()"
        />
        <div class="stage-scrim" />
      </div>
    )
  }
  <div class="stage-content shell-container">
    <div class="stage-intro" data-stage-intro>
      <h1 class="stage-title font-display" transition:name="page-title">{title}</h1>
      <div class="stage-extra">
        <div class="stage-extra-inner">
          {typedDesc && (
            <p class="stage-desc" data-typewriter>
              <span data-typewriter-text>{typedDesc}</span><span
                class="type-caret"
                data-typewriter-caret
                aria-hidden="true">_</span>
            </p>
          )}
          {meta && (
            <p class="stage-meta font-mono" data-typewriter><span data-typewriter-text>{metaSegments.map((seg) =>
                  'n' in seg ? (
                    <span class="meta-num" data-count-to={seg.n} data-decimals={0}>{seg.n}</span>
                  ) : (
                    <>{seg.t}</>
                  )
                )}</span><span class="type-caret" data-typewriter-caret aria-hidden="true">_</span>
            </p>
          )}
        </div>
      </div>
    </div>
  </div>
  <button
    type="button"
    class="backdrop-toggle"
    data-backdrop-toggle
    aria-expanded="true"
    aria-label="折叠页面顶部区域"
    title="展开 / 折叠顶部区域"
  >
    <span class="toggle-label font-ui">收起</span>
    <Icon name="chevron-up" size={14} class="toggle-icon" />
  </button>
</section>

<style>
  .page-stage {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 320px;
    padding-top: calc(var(--nav-height) + 60px);
    background: var(--color-canvas);
    overflow: hidden;
    /* 文字色变量:默认取主题色,有背景图时由 data-img-mode 覆盖 */
    --stage-fg: var(--color-text);
    --stage-fg-2: var(--color-accent-text);
    --stage-fg-m: var(--color-muted);
    transition: min-height 0.4s ease;
  }

  @media (min-width: 1024px) {
    .page-stage {
      min-height: 380px;
    }
  }

  .stage-backdrop {
    position: absolute;
    inset: 0;
    transition: opacity 0.45s ease;
  }

  .stage-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .stage-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      var(--color-overlay) 58%,
      var(--color-canvas) 98%
    );
  }

  :global(html[data-theme='dark']) .page-stage:not([data-img-mode]) .stage-scrim {
    background: linear-gradient(
      to bottom,
      rgba(23, 25, 22, 0.35) 0%,
      var(--color-overlay) 58%,
      var(--color-canvas) 98%
    );
  }


  /* 图上文字模式:构建期按图片底部采样带亮度决定(见 utils/image-luminance) */
  .page-stage[data-img-mode='on-dark'] {
    --stage-fg: #f2f3ec;
    --stage-fg-2: color-mix(in oklab, var(--color-accent) 50%, #ffffff);
    --stage-fg-m: rgba(242, 243, 236, 0.74);
  }

  .page-stage[data-img-mode='on-light'] {
    --stage-fg: #1b1d1a;
    --stage-fg-2: color-mix(in oklab, var(--color-accent-text) 78%, #1b1d1a);
    --stage-fg-m: rgba(27, 29, 26, 0.74);
  }

  /* 折叠后背景图隐藏,文字回落主题色(含深色主题) */
  :global(html[data-theme='dark']) .page-stage[data-img-mode].is-collapsed,
  .page-stage[data-img-mode].is-collapsed {
    --stage-fg: var(--color-text);
    --stage-fg-2: var(--color-accent-text);
    --stage-fg-m: var(--color-muted);
  }

  .page-stage[data-img-mode='on-dark'] .stage-scrim {
    background: linear-gradient(
      to bottom,
      rgba(18, 20, 17, calc(var(--img-scrim, 0.35) * 0.55)) 0%,
      rgba(18, 20, 17, var(--img-scrim, 0.35)) 55%,
      var(--color-canvas) 98%
    );
  }

  .page-stage[data-img-mode='on-light'] .stage-scrim {
    background: linear-gradient(
      to bottom,
      rgba(244, 245, 241, calc(var(--img-scrim, 0.35) * 0.45)) 0%,
      rgba(244, 245, 241, var(--img-scrim, 0.35)) 55%,
      var(--color-canvas) 98%
    );
  }


  /* 深色主题:有图一律收暗 + 浅字(处理后亮度恒 <128) */
  :global(html[data-theme='dark']) .page-stage[data-img-mode] {
    --stage-fg: #f2f3ec;
    --stage-fg-2: color-mix(in oklab, var(--color-accent) 50%, #ffffff);
    --stage-fg-m: rgba(242, 243, 236, 0.74);
  }

  :global(html[data-theme='dark']) .page-stage[data-img-mode] .stage-scrim {
    background: linear-gradient(
      to bottom,
      rgba(18, 20, 17, calc(var(--img-scrim-dark, 0.45) * 0.55)) 0%,
      rgba(18, 20, 17, var(--img-scrim-dark, 0.45)) 55%,
      var(--color-canvas) 98%
    );
  }

  .stage-content {
    position: relative;
    text-align: center;
    padding-bottom: 110px;
    transition: padding-bottom 0.4s ease;
  }

  .stage-title {
    font-size: clamp(32px, 5vw, 46px);
    font-weight: 700;
    color: var(--stage-fg);
    overflow-wrap: anywhere;
    transition:
      font-size 0.4s ease,
      color 0.3s ease;
  }

  /* 描述与 meta:grid 行高动画，折叠/展开对称平滑 */
  .stage-extra {
    display: grid;
    grid-template-rows: 1fr;
    opacity: 1;
    transition:
      grid-template-rows 0.4s ease,
      opacity 0.3s ease;
  }

  .stage-extra-inner {
    overflow: hidden;
    min-height: 0;
  }

  .stage-desc {
    margin: 12px auto 0;
    max-width: 560px;
    font-size: 15.5px;
    color: var(--stage-fg-m);
  }

  /* 下划线光标:零宽度占位(不占布局，不顶动文字),打完代替句号常亮闪烁 */
  .stage-desc .type-caret,
  .stage-meta .type-caret {
    display: inline-block;
    width: 0;
    overflow: visible;
    visibility: hidden;
    transform: translateX(1px);
    font-family: var(--font-mono);
    color: var(--stage-fg-2, var(--color-accent));
    animation: caret-blink 0.85s steps(1) infinite;
  }

  [data-typewriter][data-typing='true'] .type-caret,
  [data-typewriter][data-done='true'] .type-caret {
    visibility: visible;
  }

  /* 光标下移:desc 打完、meta 开时,desc 的光标淡出(meta 的光标成为终点) */
  [data-typewriter][data-caret='fade'][data-done='true'] .type-caret {
    animation: none;
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .stage-meta .meta-num {
    color: var(--stage-fg-2);
  }

  @keyframes caret-blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }

  .stage-meta {
    margin-top: 14px;
    font-size: 12.5px;
    letter-spacing: 0.04em;
    color: var(--stage-fg-m);
  }

  .backdrop-toggle {
    position: absolute;
    bottom: 18px;
    right: clamp(16px, 4vw, 40px);
    z-index: 5;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 6px 12px;
    font-family: var(--font-ui);
    font-size: 12.5px;
    color: var(--color-muted);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    box-shadow: var(--shadow-raised);
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .backdrop-toggle:hover {
    color: var(--color-text);
    border-color: var(--color-accent);
  }

  :global(.toggle-icon) {
    transition: transform 0.3s ease;
  }

  /* 折叠状态:与展开共用同一组可动画属性，双向平滑 */
  .page-stage.is-collapsed {
    min-height: 0;
  }

  .page-stage.is-collapsed .stage-content {
    padding-bottom: 24px;
  }

  .page-stage.is-collapsed .stage-extra {
    grid-template-rows: 0fr;
    opacity: 0;
  }

  .page-stage.is-collapsed .stage-backdrop {
    opacity: 0;
  }

  .page-stage.is-collapsed .stage-title {
    font-size: 24px;
  }

  .page-stage.is-collapsed :global(.toggle-icon) {
    transform: rotate(180deg);
  }
</style>

<script>
  import { runTypewriter } from '../scripts/typewriter';

  function initBackdropToggle() {
    document.querySelectorAll<HTMLElement>('[data-stage]').forEach((stage) => {
      const btn = stage.querySelector<HTMLButtonElement>('[data-backdrop-toggle]');
      const label = btn?.querySelector('.toggle-label');
      if (!btn) return;

      btn.addEventListener('click', () => {
        const collapsed = stage.classList.toggle('is-collapsed');
        btn.setAttribute('aria-expanded', String(!collapsed));
        btn.setAttribute('aria-label', collapsed ? '展开页面顶部区域' : '折叠页面顶部区域');
        if (label) label.textContent = collapsed ? '展开' : '收起';
      });
    });
  }

  /* 描述 → meta 顺序打字,光标随行下移(desc 打完淡出,meta 的光标成为终点);
     减少动态偏好时保持 SSR 全文 */
  let typeCtrl: AbortController | undefined;

  async function runStageSequence(signal: AbortSignal) {
    const desc = document.querySelector<HTMLElement>('.stage-desc[data-typewriter]');
    const meta = document.querySelector<HTMLElement>('.stage-meta[data-typewriter]');
    if (!desc && !meta) return;
    if (desc) await runTypewriter(desc, { charDelay: 45, delay: 460, signal });
    if (signal.aborted) return;
    if (meta) {
      if (desc) desc.dataset.caret = 'fade';
      await runTypewriter(meta, { charDelay: 34, delay: 60, signal });
    }
  }

  function initStageTyping() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    typeCtrl?.abort();
    typeCtrl = new AbortController();
    runStageSequence(typeCtrl.signal);
  }

  document.addEventListener('astro:page-load', () => {
    initBackdropToggle();
    initStageTyping();
  });
  document.addEventListener('astro:before-swap', () => typeCtrl?.abort());
</script>
