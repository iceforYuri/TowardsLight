---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { u } from '../utils/url';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell-container footer-inner">
    <div class="footer-info">
      <span class="footer-name font-display">{site.siteName}</span>
      <span class="footer-tagline">{site.shortBio}</span>
    </div>
    <nav class="footer-links" aria-label="页脚导航">
      {
        site.socialLinks.map((link) => (
          <a
            href={u(link.href)}
            class="footer-link"
            {...(link.href.startsWith('http')
              ? { target: '_blank', rel: 'noopener noreferrer' }
              : {})}
          >
            <Icon name={link.icon} size={14} />
            <span>{link.label}</span>
          </a>
        ))
      }
    </nav>
    <div class="footer-meta font-mono">
      <span>© {year} {site.author}</span>
      <span class="footer-sep" aria-hidden="true">·</span>
      <span>Built with Astro</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 96px;
    padding-block: 40px 48px;
    border-top: 1px solid var(--color-border);
    /* 显式画布底:首页固定壁纸层(z:-1)全局存在,页脚必须自带底色;
       其他页与 body 底色同色,视觉无变化 */
    background: var(--color-canvas);
    transition: background-color 0.35s ease;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    text-align: center;
  }

  .footer-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .footer-name {
    font-size: 18px;
    color: var(--color-text);
  }

  .footer-tagline {
    font-size: var(--text-sm);
    font-weight: var(--weight-label);
    color: var(--color-muted);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }

  /* 胶囊式图标 + 文字 */
  .footer-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 16px;
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: var(--weight-label);
    color: var(--color-muted);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      background-color 0.2s ease,
      transform 0.2s ease;
  }

  .footer-link:hover {
    color: var(--color-accent-text);
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
    transform: translateY(-1px);
  }

  .footer-meta {
    font-size: var(--text-xs);
    font-weight: var(--weight-label);
    color: var(--color-muted);
    display: flex;
    gap: 8px;
    opacity: 0.8;
  }
</style>
