---
import Icon from './Icon.astro';
import { formatDate, type Post } from '../utils/posts';
import { u } from '../utils/url';

interface Props {
  post: Post;
  showUpdated?: boolean;
  showDescription?: boolean;
}

const { post, showUpdated = false, showDescription = true } = Astro.props;
const { title, description, pubDate, updatedDate, category, tags } = post.data;
---

<article class="post-item">
  <div class="post-item-link">
    <time class="post-date font-mono" datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
    <div class="post-main">
      <h3 class="post-title">
        <a href={u(`/posts/${post.id}`)} class="title-link">{title}</a>
      </h3>
      {showDescription && <p class="post-desc">{description}</p>}
      <div class="post-meta font-mono">
        <a href={u(`/categories/${encodeURIComponent(category)}`)} class="meta-category">
          <Icon name="folder" size={13} />
          {category}
        </a>
        {
          tags.slice(0, 4).map((tag) => (
            <a href={u(`/tags/${encodeURIComponent(tag)}`)} class="meta-tag">
              <Icon name="tag" size={12} />
              {tag}
            </a>
          ))
        }
        {
          showUpdated && updatedDate && (
            <span class="meta-updated" title="最近更新">
              <Icon name="refresh-cw" size={12} />
              {formatDate(updatedDate)}
            </span>
          )
        }
      </div>
    </div>
    <span class="post-arrow" aria-hidden="true">
      <Icon name="arrow-right" size={16} />
    </span>
  </div>
</article>

<style>
  .post-item {
    position: relative;
  }

  .post-item-link {
    display: flex;
    align-items: baseline;
    gap: clamp(16px, 3vw, 32px);
    padding: 20px 8px;
    color: var(--color-text);
    border-radius: var(--radius-sm);
    transition: background-color 0.2s ease;
  }

  .post-item-link:hover {
    background: var(--color-surface-raised);
  }

  .post-date {
    flex-shrink: 0;
    width: 86px;
    font-size: var(--text-sm);
    font-weight: var(--weight-label);
    color: var(--color-muted);
    padding-top: 3px;
  }

  .post-main {
    flex: 1;
    min-width: 0;
  }

  .post-title {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 700;
    line-height: 1.5;
    color: var(--color-text);
    /* 超长标题:最多两行，优雅截断 */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    overflow-wrap: anywhere;
    transition: color 0.2s ease;
  }

  /* 标题链接:文字本身可点，点击范围通过 ::after 拉伸到整行 */
  .title-link {
    color: inherit;
  }

  .title-link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-sm);
  }

  .post-item-link:hover .post-title {
    color: var(--color-accent-text);
  }

  .post-desc {
    margin-top: 4px;
    font-size: var(--text-lg);
    line-height: 1.7;
    color: var(--color-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 14px;
    margin-top: 8px;
    font-size: var(--text-xs);
    font-weight: var(--weight-label);
  }

  /* 分类与标签入口:浮在拉伸链接之上 */
  .meta-category,
  .meta-tag {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    max-width: 200px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    border-radius: 4px;
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }

  /* 分类:苔绿 + 文件夹 */
  .meta-category {
    color: var(--color-contrast);
  }

  .meta-category:hover {
    color: var(--color-text);
    background: var(--color-contrast-soft);
  }

  /* 标签:褐红 + 小标签图标，不用 # 前缀 */
  .meta-tag {
    color: var(--color-accent-text);
  }

  .meta-tag:hover {
    color: var(--color-accent);
    background: var(--color-accent-soft);
  }

  .meta-updated {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--color-muted);
    opacity: 0.85;
  }

  .post-arrow {
    flex-shrink: 0;
    align-self: center;
    color: var(--color-muted);
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .post-item-link:hover .post-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  @media (max-width: 640px) {
    .post-item-link {
      flex-direction: column;
      gap: 4px;
      padding: 16px 4px;
    }

    .post-date {
      width: auto;
      padding-top: 0;
    }

    .post-arrow {
      display: none;
    }
  }
</style>
