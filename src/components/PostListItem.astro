---
import Icon from './Icon.astro';
import { formatDate, type Post } from '../utils/posts';

interface Props {
  post: Post;
  showUpdated?: boolean;
  showDescription?: boolean;
}

const { post, showUpdated = false, showDescription = true } = Astro.props;
const { title, description, pubDate, updatedDate, category, tags } = post.data;
---

<article class="post-item">
  <a href={`/posts/${post.id}`} class="post-item-link">
    <time class="post-date font-mono" datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
    <div class="post-main">
      <h3 class="post-title">{title}</h3>
      {showDescription && <p class="post-desc">{description}</p>}
      <div class="post-meta font-mono">
        <span class="meta-category">
          <Icon name="folder" size={13} />
          {category}
        </span>
        {tags.slice(0, 4).map((tag) => <span class="meta-tag">#{tag}</span>)}
        {
          showUpdated && updatedDate && (
            <span class="meta-updated" title="最近更新">
              <Icon name="refresh-cw" size={12} />
              {formatDate(updatedDate)}
            </span>
          )
        }
      </div>
    </div>
    <span class="post-arrow" aria-hidden="true">
      <Icon name="arrow-right" size={16} />
    </span>
  </a>
</article>

<style>
  .post-item-link {
    display: flex;
    align-items: baseline;
    gap: clamp(16px, 3vw, 32px);
    padding: 20px 8px;
    color: var(--color-text);
    border-radius: var(--radius-sm);
    transition: background-color 0.2s ease;
  }

  .post-item-link:hover {
    background: var(--color-surface-raised);
    color: var(--color-text);
  }

  .post-date {
    flex-shrink: 0;
    width: 86px;
    font-size: 13px;
    color: var(--color-muted);
    padding-top: 3px;
  }

  .post-main {
    flex: 1;
    min-width: 0;
  }

  .post-title {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 600;
    line-height: 1.5;
    color: var(--color-text);
    /* 超长标题:最多两行,优雅截断 */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    overflow-wrap: anywhere;
    transition: color 0.2s ease;
  }

  .post-item-link:hover .post-title {
    color: var(--color-accent-text);
  }

  .post-desc {
    margin-top: 4px;
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--color-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    margin-top: 8px;
    font-size: 12px;
    color: var(--color-muted);
  }

  .meta-category {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--color-contrast);
  }

  .meta-tag {
    max-width: 180px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .meta-updated {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    opacity: 0.85;
  }

  .post-arrow {
    flex-shrink: 0;
    align-self: center;
    color: var(--color-muted);
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .post-item-link:hover .post-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  @media (max-width: 640px) {
    .post-item-link {
      flex-direction: column;
      gap: 4px;
      padding: 16px 4px;
    }

    .post-date {
      width: auto;
      padding-top: 0;
    }

    .post-arrow {
      display: none;
    }
  }
</style>
