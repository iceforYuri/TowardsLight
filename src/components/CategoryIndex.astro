---
import Icon from './Icon.astro';
import type { Post } from '../utils/posts';
import { formatDate } from '../utils/posts';
import { site } from '../data/site';
import { u } from '../utils/url';

interface Props {
  categories: [string, Post[]][];
}

const { categories } = Astro.props;

const fallback = { icon: 'folder', tone: 'accent' as const, description: '这个分类下的文章' };
const metaOf = (name: string) => site.categoryMeta[name] ?? fallback;
---

<div class="category-index" data-category-index>
  {
    categories.map(([name, posts], i) => {
      const meta = metaOf(name);
      return (
        <a
          href={u(`/categories/${encodeURIComponent(name)}`)}
          class="category-card"
          data-tone={meta.tone}
          style={`--enter-delay: ${i * 40}ms`}
        >
          <div class="card-head">
            <span class:list={['card-icon', `tone-${meta.tone}`]} aria-hidden="true">
              <Icon name={meta.icon} size={17} />
            </span>
            <span class="card-count font-mono">{posts.length} 篇</span>
          </div>
          <h2 class="card-name font-display">{name}</h2>
          <p class="card-desc">{meta.description}</p>
          <p class="card-latest font-mono">最近更新 {formatDate(posts[0].data.pubDate)}</p>
        </a>
      );
    })
  }
</div>

<style>
  .category-index {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 16px;
  }

  .category-card {
    display: flex;
    flex-direction: column;
    padding: 22px;
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text);
    transition:
      border-color 0.25s ease,
      box-shadow 0.25s ease,
      transform 0.25s ease;
  }

  .category-card:hover {
    /* hover 边框跟随分类色调(默认褐红;青绿/钢蓝见下) */
    border-color: var(--ct, var(--color-accent));
    box-shadow: var(--shadow-raised);
    transform: translateY(-2px);
    color: var(--color-text);
  }

  .category-card[data-tone='contrast'] {
    --ct: var(--color-contrast);
  }
  .category-card[data-tone='steel'] {
    --ct: var(--color-steel);
  }

  /* 入场交错浮现:JS+动效允许时先隐藏，转场结束后由 .ready 触发 */
  :global(html[data-typewriter='on']) .category-card {
    opacity: 0;
  }

  :global(html[data-typewriter='on']) [data-category-index].ready .category-card {
    opacity: 1;
    animation: card-rise 0.5s cubic-bezier(0.22, 0.61, 0.36, 1) backwards;
    animation-delay: var(--enter-delay, 0ms);
  }

  @keyframes card-rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  .card-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
  }

  .card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 9px;
  }

  /* 三色池:褐红(accent)/ 青绿(contrast)/ 钢蓝(steel),由 categoryMeta 固定分配 */
  .card-icon.tone-contrast {
    background: var(--color-contrast-soft);
    color: var(--color-contrast);
  }

  .card-icon.tone-accent {
    background: var(--color-accent-soft);
    color: var(--color-accent-text);
  }

  .card-icon.tone-steel {
    background: var(--color-steel-soft);
    color: var(--color-steel);
  }

  .card-count {
    font-size: var(--text-xs);
    font-weight: var(--weight-label);
    color: var(--color-muted);
  }

  .card-name {
    font-size: 21px;
    font-weight: 700;
  }

  .card-desc {
    margin-top: 6px;
    font-size: var(--text-sm);
    font-weight: var(--weight-label);
    line-height: 1.65;
    color: var(--color-muted);
    flex: 1;
  }

  .card-latest {
    margin-top: 14px;
    font-size: var(--text-xs);
    font-weight: var(--weight-label);
    color: var(--color-muted);
    opacity: 0.8;
  }
</style>

<script>
  /* 入场门控:astro:page-load 在转场动画开始时就触发(updateCallbackDone),
     转场快照会盖住新页面的入场动画;延迟 420ms(转场时长上限)再加 .ready */
  function initCategoryIndex() {
    window.setTimeout(() => {
      document
        .querySelectorAll<HTMLElement>('[data-category-index]')
        .forEach((root) => root.classList.add('ready'));
    }, 420);
  }
  document.addEventListener('astro:page-load', initCategoryIndex);
</script>
