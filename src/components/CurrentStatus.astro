---
import { site } from '../data/site';

const { mode, text } = site.currentStatus;

const modeLabel: Record<string, string> = {
  writing: 'Writing',
  building: 'Building',
  available: 'Available',
  offline: 'Offline',
};
---

<div
  class="current-status"
  role="status"
  aria-label={`当前状态:${modeLabel[mode]}`}
  transition:name="hero-status"
>
  <span class:list={['status-dot', `mode-${mode}`]} aria-hidden="true"></span>
  <span class="status-mode font-mono">{modeLabel[mode]}</span>
  <span class="status-text">{text}</span>
</div>

<style>
  .current-status {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 7px 16px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    box-shadow: var(--shadow-raised);
    font-size: 13px;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .mode-building {
    background: var(--color-accent);
  }

  .mode-writing {
    background: var(--color-contrast);
  }

  .mode-available {
    background: #6da34d;
  }

  .mode-offline {
    background: var(--color-muted);
  }

  .status-mode {
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent-text);
  }

  .status-text {
    color: var(--color-muted);
  }

  @media (max-width: 480px) {
    .status-text {
      max-width: 200px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }
</style>
