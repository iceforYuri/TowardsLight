{
  "name": "personal-tech-blog",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "predev": "node scripts/use-profile.mjs && node scripts/optimize-images.mjs",
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "node scripts/use-profile.mjs && node scripts/optimize-images.mjs",
    "build": "astro check && astro build",
    "build:personal": "npm run build -- --outDir dist-personal",
    "precheck": "node scripts/use-profile.mjs && node scripts/optimize-images.mjs",
