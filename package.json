    "new-profile": "node scripts/new-profile.mjs",
    "test": "node scripts/test-image-guard.mjs && node scripts/test-alerts.mjs && node scripts/test-tables.mjs",
    "test:nav": "node scripts/test-nav-transition.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "frontmatter:check": "node scripts/check-frontmatter.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "fonts:display": "python scripts/subset-display-fonts.py"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.5",
    "fuse.js": "^7.5.0",
    "katex": "0.16.47",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/rss": "^4.0.12",
    "@types/node": "^26.6.3",
    "mermaid-isomorphic": "^3.1.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.0"
  }
